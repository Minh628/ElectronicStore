@model ElectronicStore_mvc.Models.Entities.Order
@{
    ViewData["Title"] = "Đặt Hàng Thành Công";
    var normStatus = Model?.OrderStatus switch
    {
        "Chờ xử lý" or "Pending" => "Pending",
        "Đã duyệt" or "Confirmed" => "Confirmed",
        "Đang giao" or "Đang giao hàng" or "Shipping" => "Shipping",
        "Hoàn thành" or "Đã giao" or "Hoàn tất" or "Completed" => "Completed",
        "Đã hủy" or "Cancelled" => "Cancelled",
        _ => Model?.OrderStatus ?? "Pending"
    };
    var statusClass = normStatus switch
    {
        "Pending" => "status-pending",
        "Confirmed" => "status-confirmed",
        "Shipping" => "status-shipping",
        "Completed" => "status-completed",
        "Cancelled" => "status-cancelled",
        _ => "status-pending"
    };
    var statusLabel = normStatus switch
    {
        "Pending" => "Chờ duyệt",
        "Confirmed" => "Đã duyệt",
        "Shipping" => "Đang giao",
        "Completed" => "Hoàn thành",
        "Cancelled" => "Đã hủy",
        _ => Model?.OrderStatus
    };
}

<div class="container py-3">
    <!-- Stepper 3 bước -->
    <div class="checkout-stepper mb-5">
        <a asp-controller="Cart" asp-action="Index" class="stepper-step completed text-decoration-none">
            <span class="stepper-num">1</span>
            <span>Giỏ hàng</span>
        </a>
        <div class="stepper-divider"></div>
        <a asp-controller="Checkout" asp-action="Index" class="stepper-step completed text-decoration-none">
            <span class="stepper-num">2</span>
            <span>Thanh toán</span>
        </a>
        <div class="stepper-divider"></div>
        <div class="stepper-step active">
            <span class="stepper-num">3</span>
            <span>Hoàn tất</span>
        </div>
    </div>

    <!-- Celebration Checkmark -->
    @if (Model != null)
    {
        <div class="text-center mb-4">
            @if (normStatus == "Cancelled")
            {
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" 
                     style="width: 72px; height: 72px; background: #fee2e2; color: #dc2626;">
                    <svg width="36" height="36" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </div>
                <h2 class="fw-bold text-dark mb-2" style="font-size:2.2rem; letter-spacing:-0.02em;">Đơn hàng đã hủy</h2>
                <p class="text-secondary small mb-3">
                    Đơn hàng của @(Model.ReceiverName ?? Model.User?.FullName ?? "bạn") đã được hủy.
                </p>
            }
            else
            {
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" 
                     style="width: 72px; height: 72px; background: #dcfce7; color: #16a34a;">
                    <svg width="36" height="36" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <h2 class="fw-bold text-dark mb-2" style="font-size:2.2rem; letter-spacing:-0.02em;">Đặt hàng thành công!</h2>
                <p class="text-secondary small mb-3">
                    Cảm ơn @(Model.ReceiverName ?? Model.User?.FullName ?? "bạn"). Công nghệ mới đang trên đường đến với bạn.
                </p>
            }

            <div class="d-inline-flex align-items-center gap-2 small">
                <span class="fw-bold text-dark">Mã đơn hàng #ES@(Model.Id.ToString("D7"))</span>
                <span class="demo-badge-status @statusClass">@statusLabel</span>
            </div>
        </div>
    }

    <!-- Receipt Card -->
    <div class="bg-white border rounded-4 p-4 p-md-5 mx-auto shadow-sm mb-4" style="max-width: 780px;">
        @if (Model != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <h5 class="fw-bold text-dark mb-0">Thông tin đơn hàng</h5>
                <span class="small text-secondary">Đặt lúc @Model.OrderDate.ToString("HH:mm • dd/MM/yyyy")</span>
            </div>

            <!-- Items -->
            <div class="d-flex flex-column gap-3 mb-4">
                @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                {
                    @foreach (var detail in Model.OrderDetails)
                    {
                        <div class="d-flex align-items-center justify-content-between gap-3 pb-3 border-bottom">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-light rounded-3 p-1 d-flex align-items-center justify-content-center" style="width:52px; height:52px;">
                                    <img src="@(string.IsNullOrEmpty(detail.Product?.ImageUrl) ? "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9" : detail.Product.ImageUrl)" 
                                         alt="@(detail.Product?.Name)" style="max-width:100%; max-height:100%; object-fit:contain;" />
                                </div>
                                <div>
                                    <div class="fw-bold text-dark small">@(detail.Product?.Name ?? "Thiết bị điện tử")</div>
                                    <div class="text-secondary small">
                                        @(detail.Product?.Brand) • Số lượng: @detail.Quantity
                                    </div>
                                </div>
                            </div>
                            <div class="fw-bold text-dark">
                                @detail.TotalPrice.ToString("N0") đ
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Total -->
            <div class="d-flex justify-content-between align-items-baseline mb-1">
                <span class="fw-bold text-dark">Tổng thanh toán</span>
                <span class="fw-extrabold text-primary fs-3">@Model.TotalAmount.ToString("N0") đ</span>
            </div>
            <div class="text-secondary small mb-4">Đã bao gồm VAT • Miễn phí giao hàng</div>

            <hr class="my-4 text-secondary opacity-25" />

            <!-- Receiver & Payment info split -->
            <div class="row g-4 small text-secondary">
                <div class="col-sm-6">
                    <div class="fw-bold text-dark text-uppercase mb-2" style="font-size:0.75rem; letter-spacing:0.05em;">Giao đến</div>
                    <div class="fw-bold text-dark mb-1">@(Model.ReceiverName ?? Model.User?.FullName) • @(Model.ReceiverPhone ?? Model.User?.PhoneNumber)</div>
                    <div class="mb-1">@Model.ShippingAddress</div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="text-muted fst-italic">Ghi chú: @Model.Notes</div>
                    }
                </div>
                <div class="col-sm-6">
                    <div class="fw-bold text-dark text-uppercase mb-2" style="font-size:0.75rem; letter-spacing:0.05em;">Thanh toán & Giao hàng</div>
                    <div class="fw-bold text-dark mb-1">
                        @(Model.PaymentMethod switch {
                            "COD" => "Thanh toán khi nhận hàng (COD)",
                            "BankTransfer" => "Chuyển khoản VietQR",
                            "VNPAY" => "Cổng VNPAY-QR",
                            "MOMO" => "Ví điện tử MoMo",
                            _ => Model.PaymentMethod
                        })
                    </div>
                    <div class="text-success fw-semibold mb-1">
                        Dự kiến nhận: @Model.OrderDate.AddDays(2).ToString("dd/MM") – @Model.OrderDate.AddDays(4).ToString("dd/MM/yyyy")
                    </div>
                    <div class="text-muted">Chúng tôi sẽ gọi điện xác nhận trước khi giao hàng.</div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 text-secondary" style="width:56px; height:56px; background:#f1f5f9;">
                    <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <h5 class="fw-bold text-dark mb-1">Không tìm thấy thông tin đơn hàng!</h5>
                <p class="text-secondary small mb-3">Đơn hàng không tồn tại hoặc đường dẫn truy cập không hợp lệ.</p>
            </div>
        }
    </div>

    <!-- Actions -->
    <div class="d-flex flex-wrap gap-3 justify-content-center mb-4">
        @if (Model != null)
        {
            <button type="button" class="btn btn-outline-secondary px-4 py-2 fw-semibold rounded-3 d-inline-flex align-items-center gap-2" onclick="window.print()">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
                </svg>
                <span>In hóa đơn</span>
            </button>
        }
        <a asp-controller="Orders" asp-action="MyOrders" asp-route-phoneNumber="@(User.Identity?.IsAuthenticated == true ? null : Model?.ReceiverPhone)" class="btn btn-primary px-4 py-2 fw-semibold rounded-3 d-inline-flex align-items-center gap-2"
           style="background:var(--accent-blue); border:none;">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            <span>Xem đơn hàng của tôi</span>
        </a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-semibold rounded-3 d-inline-flex align-items-center gap-2">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
            <span>Tiếp tục mua sắm</span>
        </a>
    </div>

    <div class="text-center text-secondary small">
        Cần thay đổi thông tin? Liên hệ <strong>1800 6868</strong> và cung cấp mã đơn hàng.
    </div>
</div>
