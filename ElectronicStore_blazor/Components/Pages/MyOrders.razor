@page "/my-orders"
@page "/MyOrders"
@inject IProductService ProductService
@inject UserService UserService
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<ElectronicStore_blazor.Data.ElectronicStoreDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Microsoft.EntityFrameworkCore

<PageTitle>Đơn Hàng Của Tôi - ElectroStore</PageTitle>

<div class="container py-3">
    <!-- Breadcrumb -->
    <nav class="mb-4" style="--bs-breadcrumb-divider: '›';">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a href="" class="text-secondary text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item text-secondary">Tài khoản</li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Đơn hàng của tôi</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Cột trái: Hồ sơ cá nhân & Menu -->
        <div class="col-lg-3">
            <div class="bg-white border rounded-4 p-4 shadow-sm mb-4">
                <!-- Avatar & Name -->
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-primary fw-bold fs-5"
                         style="width: 52px; height: 52px; background: #eff6ff; border: 2px solid #bfdbfe;">
                        @(GetInitials(UserService.CurrentUser?.FullName ?? UserService.CurrentUser?.UserName ?? "KH"))
                    </div>
                    <div class="overflow-hidden">
                        <h6 class="fw-bold text-dark mb-0 text-truncate">
                            @(UserService.CurrentUser?.FullName ?? UserService.CurrentUser?.UserName ?? "Khách hàng")
                        </h6>
                        <span class="small text-secondary">@(UserService.CurrentUser?.UserName ?? "guest")</span>
                    </div>
                </div>

                <!-- Nav list -->
                <div class="d-flex flex-column gap-1">
                    <a href="my-orders" class="p-2 px-3 rounded-3 text-decoration-none fw-semibold small d-flex align-items-center gap-2"
                       style="background: #eff6ff; color: var(--accent-blue);">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                        </svg>
                        <span>Đơn hàng của tôi</span>
                    </a>
                    <a href="profile" class="p-2 px-3 rounded-3 text-decoration-none small text-secondary d-flex align-items-center gap-2">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        <span>Thông tin tài khoản</span>
                    </a>
                    <a href="profile#address" class="p-2 px-3 rounded-3 text-decoration-none small text-secondary d-flex align-items-center gap-2">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        <span>Địa chỉ nhận hàng</span>
                    </a>
                    @if (UserService.IsAuthenticated)
                    {
                        <hr class="my-2 text-secondary opacity-25" />
                        <button type="button" class="btn btn-link p-2 px-3 text-danger text-decoration-none small text-start d-flex align-items-center gap-2"
                                @onclick="HandleLogout">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                            </svg>
                            <span>Đăng xuất</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Phone lookup box -->
            <div class="bg-white border rounded-4 p-4 shadow-sm">
                <h6 class="fw-bold text-dark mb-1">Mua không dùng tài khoản?</h6>
                <p class="text-secondary small mb-3">Tra cứu đơn hàng bằng số điện thoại người nhận.</p>
                <div class="d-flex flex-column gap-2">
                    <input type="tel" @bind="searchPhone" @bind:event="oninput" @onkeydown="HandleKeyDown"
                           class="form-control form-control-custom form-control-sm" placeholder="Nhập số điện thoại..." />
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-3 fw-semibold" @onclick="LoadOrdersByPhone">
                        Tra cứu bằng số điện thoại &rarr;
                    </button>
                </div>
            </div>
        </div>

        <!-- Cột phải: Danh sách đơn hàng -->
        <div class="col-lg-9">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                <div>
                    <h2 class="fw-bold text-dark mb-1" style="font-size:2rem; letter-spacing:-0.02em;">Đơn hàng của tôi</h2>
                    <p class="text-secondary small mb-0">Theo dõi hành trình của những thiết bị bạn yêu thích.</p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 small py-2 mb-3" role="alert">
                    <i class="bi bi-check-circle-fill me-1"></i> @successMessage
                    <button type="button" class="btn-close small" @onclick='() => successMessage = null'></button>
                </div>
            }
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 small py-2 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @errorMessage
                    <button type="button" class="btn-close small" @onclick='() => errorMessage = null'></button>
                </div>
            }

            <!-- Tabs lọc trạng thái -->
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button type="button" class="category-tab-btn @(activeTab == "All" ? "active" : "")" @onclick='() => SetTab("All")'>
                    Tất cả (@orders.Count)
                </button>
                <button type="button" class="category-tab-btn @(activeTab == "Pending" ? "active" : "")" @onclick='() => SetTab("Pending")'>
                    Chờ duyệt (@orders.Count(o => o.OrderStatus == "Pending"))
                </button>
                <button type="button" class="category-tab-btn @(activeTab == "Confirmed" ? "active" : "")" @onclick='() => SetTab("Confirmed")'>
                    Đã duyệt (@orders.Count(o => o.OrderStatus == "Confirmed"))
                </button>
                <button type="button" class="category-tab-btn @(activeTab == "Shipping" ? "active" : "")" @onclick='() => SetTab("Shipping")'>
                    Đang giao (@orders.Count(o => o.OrderStatus == "Shipping"))
                </button>
                <button type="button" class="category-tab-btn @(activeTab == "Completed" ? "active" : "")" @onclick='() => SetTab("Completed")'>
                    Hoàn thành (@orders.Count(o => o.OrderStatus == "Completed"))
                </button>
                <button type="button" class="category-tab-btn @(activeTab == "Cancelled" ? "active" : "")" @onclick='() => SetTab("Cancelled")'>
                    Đã hủy (@orders.Count(o => o.OrderStatus == "Cancelled"))
                </button>
            </div>

            <!-- List Orders -->
            @if (!FilteredOrders.Any())
            {
                <div class="bg-white border rounded-4 text-center py-5 my-3 p-4">
                    <h5 class="fw-bold text-dark mb-2">Chưa có đơn hàng nào trong mục này</h5>
                    <p class="text-secondary small mb-3">Bạn có thể xem các mục khác hoặc tiếp tục khám phá sản phẩm.</p>
                    <a href="" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold" style="background:var(--accent-blue); border:none;">
                        Khám phá sản phẩm
                    </a>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var order in FilteredOrders)
                    {
                        var statusClass = order.OrderStatus switch
                        {
                            "Pending" => "status-pending",
                            "Confirmed" => "status-confirmed",
                            "Shipping" => "status-shipping",
                            "Completed" => "status-completed",
                            "Cancelled" => "status-cancelled",
                            _ => "status-pending"
                        };
                        var statusLabel = order.OrderStatus switch
                        {
                            "Pending" => "Chờ duyệt",
                            "Confirmed" => "Đã duyệt",
                            "Shipping" => "Đang giao",
                            "Completed" => "Hoàn thành",
                            "Cancelled" => "Đã hủy",
                            _ => order.OrderStatus
                        };

                        <div class="bg-white border rounded-4 p-4 shadow-sm" @key="order.Id">
                            <!-- Card Header -->
                            <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 border-bottom mb-3 gap-2">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="fw-bold text-dark">#ES@(order.Id.ToString("D7"))</span>
                                    <span class="text-secondary small">@order.OrderDate.ToString("dd/MM/yyyy • HH:mm")</span>
                                </div>
                                <span class="demo-badge-status @statusClass">@statusLabel</span>
                            </div>

                            <!-- Products in this order -->
                            <div class="d-flex flex-column gap-3 mb-3">
                                @foreach (var d in order.OrderDetails)
                                {
                                    <div class="d-flex align-items-center justify-content-between gap-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="bg-light rounded-3 p-1 d-flex align-items-center justify-content-center" style="width:52px; height:52px;">
                                                <img src="@(string.IsNullOrEmpty(d.Product?.ImageUrl) ? "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9" : d.Product.ImageUrl)" 
                                                     alt="@d.Product?.Name" style="max-width:100%; max-height:100%; object-fit:contain;" />
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark small">@d.Product?.Name</div>
                                                <div class="text-secondary small">
                                                    @(d.Product?.Brand) • Số lượng: @d.Quantity
                                                </div>
                                            </div>
                                        </div>
                                        <div class="fw-semibold text-dark small">
                                            @d.TotalPrice.ToString("N0") đ
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Card Footer -->
                            <div class="d-flex flex-wrap justify-content-between align-items-end pt-3 border-top gap-3">
                                <div class="small text-secondary" style="max-width: 480px;">
                                    <div><strong>@order.ReceiverName</strong> • @order.ReceiverPhone</div>
                                    <div class="text-truncate">@order.ShippingAddress</div>
                                    <div class="text-muted">Thanh toán: @order.PaymentMethod • Miễn phí giao hàng</div>
                                </div>

                                <div class="text-end">
                                    <div class="small text-secondary">Tổng cộng</div>
                                    <div class="fw-extrabold text-primary fs-5 mb-2">
                                        @order.TotalAmount.ToString("N0") đ
                                    </div>
                                    <div class="d-flex align-items-center justify-content-end gap-2">
                                        @if (order.OrderStatus == "Pending" || order.OrderStatus == "Confirmed")
                                        {
                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1 fw-semibold small"
                                                    @onclick="() => HandleCancelOrder(order.Id)">
                                                Hủy đơn hàng
                                            </button>
                                        }
                                        <a href="ordersuccess?orderId=@order.Id&phone=@Uri.EscapeDataString(!string.IsNullOrWhiteSpace(searchPhone) ? searchPhone : (order.ReceiverPhone ?? ""))" class="btn btn-light btn-sm rounded-pill px-3 py-1 fw-semibold small border text-decoration-none">
                                            Xem chi tiết &rarr;
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string searchPhone = "";
    private string activeTab = "All";
    private string? successMessage;
    private string? errorMessage;
    private List<Order> orders = new();

    private IEnumerable<Order> FilteredOrders =>
        activeTab == "All" ? orders : orders.Where(o => o.OrderStatus == activeTab);

    protected override void OnInitialized()
    {
        if (UserService.IsAuthenticated && UserService.CurrentUser != null)
        {
            LoadUserOrders();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !UserService.IsAuthenticated)
        {
            var restored = await UserService.RestoreSessionAsync(JS);
            if (restored && UserService.CurrentUser != null)
            {
                LoadUserOrders();
                StateHasChanged();
            }
        }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private async Task HandleCancelOrder(int orderId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn HỦY đơn hàng này? Số lượng sản phẩm sẽ được tự động hoàn lại vào kho.");
        if (!confirmed) return;

        string? currentUserId = (UserService.IsAuthenticated && UserService.CurrentUser != null) ? UserService.CurrentUser.Id : null;
        string? effectivePhone = !string.IsNullOrWhiteSpace(searchPhone) ? searchPhone : UserService.CurrentUser?.PhoneNumber;
        var result = ProductService.CancelOrder(orderId, isClient: true, requesterUserId: currentUserId, requesterPhone: effectivePhone);
        if (result.Success)
        {
            successMessage = result.Message;
            errorMessage = null;
            // Tải lại danh sách đơn hàng
            if (!string.IsNullOrWhiteSpace(searchPhone))
            {
                LoadOrdersByPhone();
            }
            else if (UserService.IsAuthenticated && UserService.CurrentUser != null)
            {
                LoadUserOrders();
            }
        }
        else
        {
            errorMessage = result.Message;
            successMessage = null;
        }
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "KH";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private void LoadUserOrders()
    {
        using var context = DbFactory.CreateDbContext();
        var username = UserService.CurrentUser?.UserName;
        orders = context.Orders
            .Include(o => o.User)
            .Include(o => o.OrderDetails)
                .ThenInclude(od => od.Product)
            .Where(o => o.User != null && o.User.UserName == username)
            .OrderByDescending(o => o.OrderDate)
            .ToList();
    }

    private void LoadOrdersByPhone()
    {
        if (string.IsNullOrWhiteSpace(searchPhone)) return;

        using var context = DbFactory.CreateDbContext();
        orders = context.Orders
            .Include(o => o.User)
            .Include(o => o.OrderDetails)
                .ThenInclude(od => od.Product)
            .Where(o => o.ReceiverPhone == searchPhone.Trim())
            .OrderByDescending(o => o.OrderDate)
            .ToList();
        activeTab = "All";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            LoadOrdersByPhone();
        }
    }

    private async Task HandleLogout()
    {
        await UserService.LogoutAsync(JS);
        Navigation.NavigateTo("", true);
    }
}
