@page "/ProductDetail"
@page "/ProductDetail/{id:int}"
@page "/product/{id:int}"
@page "/product-detail/{id:int}"
@inject IProductService ProductService
@inject CartService Cart
@inject NavigationManager Navigation

<PageTitle>@(product?.Name ?? "Chi tiết sản phẩm") - ElectroStore</PageTitle>

<div class="container py-3">
    <!-- Breadcrumb -->
    <nav class="mb-4" style="--bs-breadcrumb-divider: '›';">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a href="" class="text-secondary text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/?category=@(product?.CategoryId)" class="text-secondary text-decoration-none">@(product?.Category?.Name ?? "Danh mục")</a></li>
            <li class="breadcrumb-item"><a href="/?brand=@(product?.Brand)" class="text-secondary text-decoration-none">@product?.Brand</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">@(product?.Name ?? "")</li>
        </ol>
    </nav>

    @if (product != null)
    {
        var discountPrice = product.Price * 1.15m;
        <div class="row g-5 mb-5">
            <!-- Cột trái: Thư viện ảnh sản phẩm -->
            <div class="col-lg-6">
                <div class="detail-gallery-main mb-3 position-relative">
                    <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-3 py-2 rounded-pill small position-absolute" style="top:18px; left:18px;">
                        @(product.Brand) • Chính hãng
                    </span>
                    <img src="@activeImage" alt="@product.Name" class="img-fluid" style="@(isImageFlipped ? "transform: scaleX(-1);" : "")" />
                </div>
                <!-- Thumbnails -->
                <div class="d-flex align-items-center justify-content-center gap-2">
                    <div class="detail-thumb @(!isImageFlipped ? "active" : "")" @onclick="() => SetActiveImage(product.ImageUrl, false)">
                        <img src="@product.ImageUrl" alt="Thumbnail 1" />
                    </div>
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <div class="detail-thumb @(isImageFlipped ? "active" : "")" @onclick="() => SetActiveImage(product.ImageUrl, true)">
                            <img src="@product.ImageUrl" alt="Thumbnail 2" style="transform: scaleX(-1);" />
                        </div>
                    }
                </div>
                <div class="text-center text-secondary small mt-2">
                    Hình ảnh sản phẩm • @product.Brand chính hãng
                </div>
            </div>

            <!-- Cột phải: Thông tin, Giá & Mua hàng -->
            <div class="col-lg-6">
                <!-- Badges -->
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="text-primary fw-bold text-uppercase small" style="letter-spacing:0.05em;">@product.Brand</span>
                    <span class="badge bg-success bg-opacity-10 text-success fw-semibold px-2 py-1 rounded-pill small">
                        Bảo hành chính hãng @product.WarrantyMonths tháng
                    </span>
                </div>

                <!-- Title -->
                <h1 class="text-dark fw-bold mb-2" style="font-size: 2.2rem; letter-spacing: -0.02em;">
                    @product.Name
                </h1>

                <!-- Specs sub-line & Code -->
                <div class="text-secondary small mb-2">
                    @product.Specifications • Mã SP: ES-@product.Id.ToString("D5")
                </div>

                <!-- Rating -->
                <div class="d-flex align-items-center gap-2 mb-3 small">
                    <span class="text-warning">★★★★★</span>
                    <span class="fw-bold text-dark">4.9 / 5</span>
                    <span class="text-secondary">• 128 đánh giá</span>
                </div>

                <!-- Price Box -->
                <div class="d-flex align-items-baseline gap-3 mb-1">
                    <span class="fw-extrabold text-primary" style="font-size: 2.2rem;">
                        @product.Price.ToString("N0") đ
                    </span>
                    <span class="text-secondary text-decoration-line-through small">
                        @discountPrice.ToString("N0") đ
                    </span>
                    <span class="badge bg-primary bg-opacity-10 text-primary fw-bold small px-2 py-1">
                        -14%
                    </span>
                </div>
                <div class="text-secondary small mb-4">
                    Giá đã bao gồm VAT • Miễn phí giao hàng toàn quốc
                </div>

                <!-- Phiên bản dung lượng (Linh hoạt hiển thị) -->
                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary mb-2">Phiên bản thiết bị</label>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold active rounded-3">
                            Bản tiêu chuẩn
                        </button>
                    </div>
                </div>

                <!-- Quantity Stepper -->
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="input-group" style="width: 130px;">
                            <button class="btn btn-outline-secondary" type="button" @onclick="DecreaseQuantity" disabled="@(quantity <= 1)">-</button>
                            <input type="number" class="form-control text-center fw-bold bg-white" min="1" max="@(product?.Quantity ?? 99)" value="@quantity" @onchange="OnQuantityInputChanged" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="IncreaseQuantity" disabled="@(quantity >= product.Quantity)">+</button>
                        </div>
                        <div class="small fw-semibold @(product.Quantity > 0 ? "text-success" : "text-danger")">
                            @(product.Quantity > 0 ? $"● Còn {product.Quantity} sản phẩm" : "● Hết hàng")
                        </div>
                    </div>
                </div>

                <!-- Action Buttons: Thêm vào giỏ & Mua ngay -->
                <div class="d-flex gap-3 mb-4">
                    <button type="button" class="btn btn-outline-secondary flex-grow-1 py-3 fw-bold rounded-3 d-flex align-items-center justify-content-center gap-2"
                            @onclick="AddToCart" disabled="@(product.Quantity <= 0)">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                        </svg>
                        <span>Thêm vào giỏ</span>
                    </button>
                    <button type="button" class="btn btn-primary flex-grow-1 py-3 fw-bold rounded-3 d-flex align-items-center justify-content-center gap-2"
                            style="background:var(--accent-blue); border:none;"
                            @onclick="BuyNow" disabled="@(product.Quantity <= 0)">
                        <span>Mua ngay</span>
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                    </button>
                </div>

                <!-- Perks Box -->
                <div class="p-3 rounded-3 mb-3" style="background:#eff6ff; border:1px solid #dbeafe;">
                    <div class="fw-bold text-primary small mb-1">Ưu đãi dành riêng cho bạn</div>
                    <ul class="list-unstyled small text-secondary mb-0 d-flex flex-column gap-1">
                        <li>• Tặng gói dán màn hình cao cấp & hỗ trợ chuyển dữ liệu miễn phí.</li>
                        <li>• Giảm thêm 500.000đ khi thanh toán qua chuyển khoản VietQR.</li>
                    </ul>
                </div>

                <div class="d-flex align-items-center gap-4 text-secondary small">
                    <span>✓ Đổi mới 30 ngày nếu lỗi NSX</span>
                    <span>✓ Giao hàng hỏa tốc 2-4 ngày</span>
                </div>
            </div>
        </div>

        <!-- ================= BOTTOM SPLIT: HIGHLIGHTS & SPECS TABLE ================= -->
        <div id="specs" class="row g-4 mb-5 pt-3">
            <!-- Left Dark Marketing Box -->
            <div class="col-lg-6">
                <div class="p-4 p-md-5 rounded-4 h-100 text-white d-flex flex-column justify-content-between" 
                     style="background: radial-gradient(circle at 90% 10%, rgba(37,99,235,0.2) 0%, transparent 60%), linear-gradient(135deg, #0b1120 0%, #020617 100%); border:1px solid rgba(255,255,255,0.08);">
                    <div>
                        <span class="text-uppercase small fw-bold text-secondary mb-3 d-inline-block" style="letter-spacing:0.06em;">
                            Được tạo nên để khác biệt
                        </span>
                        <h3 class="fw-bold mb-3" style="font-size:2rem; line-height: 1.2;">
                            @(product.Name)<br/>
                            Hiệu năng bứt phá.
                        </h3>
                        <p class="text-secondary mb-4" style="line-height:1.7;">
                            @(string.IsNullOrEmpty(product.Description) ? "Trải nghiệm đỉnh cao công nghệ thế hệ mới với độ bền vượt trội, camera đột phá và thời lượng pin ấn tượng." : product.Description)
                        </p>
                    </div>

                    <div class="row g-3 pt-3 border-top border-secondary border-opacity-25">
                        <div class="col-4">
                            <div class="fw-bold fs-4 text-white">Chính hãng</div>
                            <div class="text-secondary small">100% nguồn gốc</div>
                        </div>
                        <div class="col-4">
                            <div class="fw-bold fs-4 text-white">@product.WarrantyMonths Tháng</div>
                            <div class="text-secondary small">Bảo hành vàng</div>
                        </div>
                        <div class="col-4">
                            <div class="fw-bold fs-4 text-white">Miễn phí</div>
                            <div class="text-secondary small">Vận chuyển toàn quốc</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Specifications Table -->
            <div class="col-lg-6">
                <div class="bg-white p-4 p-md-5 rounded-4 border h-100">
                    <h4 class="fw-bold text-dark mb-4">Thông số kỹ thuật</h4>
                    <table class="detail-specs-table">
                        <tbody>
                            <tr>
                                <td>Hãng sản xuất</td>
                                <td>@product.Brand</td>
                            </tr>
                            <tr>
                                <td>Danh mục</td>
                                <td>@(product.Category?.Name ?? "Thiết bị điện tử")</td>
                            </tr>
                            <tr>
                                <td>Cấu hình chi tiết</td>
                                <td>@(string.IsNullOrEmpty(product.Specifications) ? "Đang cập nhật" : product.Specifications)</td>
                            </tr>
                            <tr>
                                <td>Thời gian bảo hành</td>
                                <td>@product.WarrantyMonths tháng chính hãng</td>
                            </tr>
                            <tr>
                                <td>Tình trạng kho</td>
                                <td>@(product.Quantity > 0 ? $"Còn hàng ({product.Quantity} máy)" : "Tạm hết hàng")</td>
                            </tr>
                            <tr>
                                <td>Chính sách đổi trả</td>
                                <td>1 đổi 1 trong 30 ngày nếu lỗi từ NSX</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (relatedProducts.Any())
        {
            <!-- ================= SẢN PHẨM CÙNG DANH MỤC ================= -->
            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold text-dark mb-0">Sản phẩm cùng danh mục</h4>
                    <a href="/?category=@product.CategoryId" class="small fw-semibold text-primary text-decoration-none">Xem tất cả &rarr;</a>
                </div>
                <div class="row g-4">
                    @foreach (var rp in relatedProducts)
                    {
                        <div class="col-12 col-sm-6 col-lg-3" @key="rp.Id">
                            <div class="electro-product-card">
                                <a href="product/@rp.Id" class="product-img-wrapper d-block text-decoration-none">
                                    <span class="badge-stock-top @(rp.Quantity > 0 ? "in-stock" : "out-stock")">
                                        @(rp.Quantity > 0 ? $"Còn {rp.Quantity}" : "Hết hàng")
                                    </span>
                                    <img src="@(string.IsNullOrEmpty(rp.ImageUrl) ? "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9" : rp.ImageUrl)" alt="@rp.Name" />
                                </a>
                                <div class="product-card-body">
                                    <div class="product-brand">@rp.Brand</div>
                                    <h6 class="product-title">
                                        <a href="product/@rp.Id" class="text-dark text-decoration-none">@rp.Name</a>
                                    </h6>
                                    <div class="product-specs">@rp.Specifications</div>
                                    <div class="product-card-footer">
                                        <div>
                                            <div class="product-price-label">Giá ưu đãi</div>
                                            <div class="product-price-value">@rp.Price.ToString("N0") đ</div>
                                        </div>
                                        <a href="product/@rp.Id" class="btn-add-cart text-decoration-none">Xem chi tiết</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    <div class="d-none"><div><div><table><tbody><tr><td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <h4 class="fw-bold text-dark">Không tìm thấy sản phẩm!</h4>
            <a href="/" class="btn btn-primary rounded-pill px-4 mt-2">Quay lại trang chủ</a>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(toastMessage))
{
    <div id="toast-container">
        <div class="electro-toast">
            <svg width="20" height="20" fill="none" stroke="#22c55e" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>@toastMessage</span>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Product? product;
    private List<Product> relatedProducts = new();
    private bool isImageFlipped = false;
    private int quantity = 1;
    private string activeImage = "";
    private string toastMessage = "";

    protected override void OnParametersSet()
    {
        if (Id.HasValue && Id.Value > 0)
        {
            product = ProductService.GetProductById(Id.Value);
        }
        else
        {
            var all = ProductService.GetAllProducts();
            product = all.FirstOrDefault();
        }

        if (product != null)
        {
            activeImage = string.IsNullOrEmpty(product.ImageUrl) ? "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9" : product.ImageUrl;
            isImageFlipped = false;
            quantity = 1;
            relatedProducts = ProductService.GetAllProducts().Where(p => p.CategoryId == product.CategoryId && p.Id != product.Id).Take(4).ToList();
        }
    }

    private void SetActiveImage(string? url, bool flip = false) { if (!string.IsNullOrEmpty(url)) { activeImage = url; isImageFlipped = flip; } }
    private void SetActiveImageUnused(string? url)
    {
        if (!string.IsNullOrEmpty(url))
        {
            activeImage = url;
        }
    }

    private void IncreaseQuantity()
    {
        if (product != null && quantity < product.Quantity)
        {
            quantity++;
        }
    }

    private void OnQuantityInputChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            int max = product?.Quantity ?? 99;
            if (val < 1) val = 1;
            if (val > max) val = max;
            quantity = val;
        }
        else
        {
            quantity = 1;
        }
    }

    private void DecreaseQuantity()
    {
        if (quantity > 1)
        {
            quantity--;
        }
    }

    private async Task AddToCart()
    {
        if (product != null)
        {
            var res = Cart.AddToCart(product, quantity);
            toastMessage = res.Message;
            StateHasChanged();
            await Task.Delay(2500);
            toastMessage = "";
            StateHasChanged();
        }
    }

    private void BuyNow()
    {
        if (product != null)
        {
            var res = Cart.AddToCart(product, quantity);
            if (!res.Success && !Cart.Items.Any(i => i.ProductId == product.Id)) { toastMessage = res.Message; return; }
            Navigation.NavigateTo("checkout");
        }
    }
}
