@page
@model ElectronicStore_razor.Pages.Admin.AccountsModel
@{
    ViewData["Title"] = "Admin - Quản Lý Tài Khoản";
    var adminCount = Model.UserRoles.Values.Count(r => r == "Admin");
    var customerCount = Model.Users.Count - adminCount;
    var lockedCount = Model.Users.Count(u => !u.IsActive);
}

<div class="container-fluid p-0">
    <!-- Tiêu Đề & Nút Thêm Mới -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <span>Quản Lý Tài Khoản & Khách Hàng</span>
                <span class="badge bg-primary rounded-pill fs-6 px-3">@Model.Users.Count tài khoản</span>
            </h3>
            <p class="text-secondary small mb-0">Theo dõi danh sách thành viên, quản lý vai trò và phân quyền khóa / mở khóa tài khoản.</p>
        </div>
        <div>
            <button type="button" class="btn btn-primary rounded-3 px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm"
                    onclick="openCreateAccountModal()">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
                <span>Thêm Tài Khoản Mới</span>
            </button>
        </div>
    </div>

    <!-- Alert Notification -->
    @if (!string.IsNullOrEmpty(Model.AlertMessage))
    {
        <div class="alert alert-@(Model.AlertType ?? "success") alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                </svg>
                <div>@Model.AlertMessage</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ================= 1. KPI SUMMARY CARDS ================= -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Tổng người dùng</div>
                    <div class="stat-value">@Model.Users.Count</div>
                    <div class="stat-subtext">Trong hệ thống</div>
                </div>
                <div class="stat-icon-wrap blue">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Khách hàng</div>
                    <div class="stat-value text-success">@customerCount</div>
                    <div class="stat-subtext">Tài khoản thành viên</div>
                </div>
                <div class="stat-icon-wrap green">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Quản trị viên</div>
                    <div class="stat-value text-primary">@adminCount</div>
                    <div class="stat-subtext">Quyền hạn tối cao</div>
                </div>
                <div class="stat-icon-wrap purple">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Tài khoản bị khóa</div>
                    <div class="stat-value text-danger">@lockedCount</div>
                    <div class="stat-subtext">Bị cấm truy cập</div>
                </div>
                <div class="stat-icon-wrap red">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= 2. THANH TÌM KIẾM ================= -->
    <div class="admin-card mb-4">
            <form method="get" id="accountSearchForm" class="row g-2 align-items-center">
                <div class="col-md-9 col-lg-10">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                            </svg>
                        </span>
                        <input type="text" id="accountSearchInput" name="SearchKeyword" value="@Model.SearchKeyword" 
                               class="form-control form-control-admin border-start-0 ps-0" 
                               placeholder="Tìm theo tên đăng nhập, họ tên, email hoặc số điện thoại..."
                               oninput="toggleClearAccountSearch(this.value)" />
                    </div>
                </div>
                <div class="col-md-3 col-lg-2 d-flex gap-2">
                    <button type="button" id="btnClearAccountSearch" class="btn btn-outline-secondary rounded-3 w-100 py-2 fw-semibold"
                            onclick="clearAccountSearch()" @(string.IsNullOrWhiteSpace(Model.SearchKeyword) ? "disabled" : "")>
                        Xóa tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ================= 3. BẢNG TÀI KHOẢN ================= -->
    <div class="admin-card mb-4">
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="ps-4">Tài Khoản</th>
                        <th>Phân Quyền</th>
                        <th>Họ Và Tên</th>
                        <th>Số Điện Thoại</th>
                        <th>Email & Địa Chỉ</th>
                        <th>Ngày Tham Gia</th>
                        <th>Trạng Thái</th>
                        <th class="pe-4 text-end">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-secondary">
                                <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="mb-2 text-muted">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                                </svg>
                                <div>Không tìm thấy tài khoản nào phù hợp với từ khóa!</div>
                            </td>
                        </tr>
                    }
                    @foreach (var user in Model.Users)
                    {
                        var role = Model.UserRoles.GetValueOrDefault(user.Id, "Customer");
                        var fullName = user.FullName;
                        if (string.IsNullOrWhiteSpace(fullName) || fullName.Contains("Quá") || fullName.Contains("Ã") || fullName.Contains("»") || fullName.Contains("Ä"))
                        {
                            fullName = user.UserName == "admin" ? "Quản Trị Viên Hệ Thống" : (user.UserName == "nguyenvana" ? "Nguyễn Văn A" : (user.UserName == "tranthib" ? "Trần Thị B" : (user.FullName ?? user.UserName)));
                        }
                        <tr>
                            <!-- Username -->
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2.5">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm"
                                         style="width: 36px; height: 36px; background: linear-gradient(135deg, #2563eb, #3b82f6); font-size: 0.85rem;">
                                        @(user.UserName?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <div>
                                        <div class="text-dark fw-bold">@user.UserName</div>
                                    </div>
                                </div>
                            </td>

                            <!-- Role -->
                            <td>
                                @if (role == "Admin")
                                {
                                    <span class="badge bg-warning text-dark fw-bold px-2.5 py-1.5" style="font-size:0.75rem;">QUẢN TRỊ VIÊN</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary border fw-medium px-2.5 py-1.5" style="font-size:0.75rem;">Khách Hàng</span>
                                }
                            </td>

                            <!-- FullName Info -->
                            <td>
                                <div class="text-dark fw-semibold">@fullName</div>
                            </td>

                            <!-- Phone -->
                            <td>
                                <span class="small text-secondary">@(user.PhoneNumber ?? "—")</span>
                            </td>

                            <!-- Email & Address -->
                            <td>
                                <div class="text-dark small">@(user.Email ?? "—")</div>
                                <div class="text-secondary small text-truncate" style="max-width:200px;" title="@user.Address">@(user.Address ?? "—")</div>
                            </td>

                            <!-- Created Date -->
                            <td>
                                <span class="small text-secondary">@user.CreatedAt.ToString("dd/MM/yyyy")</span>
                            </td>

                            <!-- Status -->
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small fw-semibold">
                                        Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 small fw-semibold">
                                        ĐÃ KHÓA
                                    </span>
                                }
                            </td>

                            <!-- Actions -->
                            <td class="pe-4 text-end">
                                <div class="d-inline-flex gap-1 align-items-center">
                                    <!-- Nút Sửa -->
                                    <button type="button" class="admin-action-btn edit" title="Sửa tài khoản"
                                            onclick="openEditAccountModal('@user.Id', '@Html.Raw(user.UserName?.Replace("'", "\\'"))', '@Html.Raw(user.FullName?.Replace("'", "\\'"))', '@Html.Raw(user.Email?.Replace("'", "\\'"))', '@Html.Raw(user.PhoneNumber?.Replace("'", "\\'"))', '@Html.Raw(user.Address?.Replace("'", "\\'"))', '@role')">
                                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                    </button>

                                    <!-- Nút Khóa / Mở Khóa -->
                                    @if (user.UserName != User.Identity?.Name)
                                    {
                                        <form method="post" asp-page-handler="ToggleActive" asp-route-userId="@user.Id" class="d-inline">
                                            @if (user.IsActive)
                                            {
                                                <button type="submit" class="admin-action-btn delete" title="Khóa tài khoản"
                                                        onclick="return confirm('Bạn có chắc muốn KHÓA tài khoản @user.UserName?');">
                                                    <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="admin-action-btn edit" title="Mở khóa tài khoản" style="color:#10b981; border-color:#86efac; background:#f0fdf4;"
                                                        onclick="return confirm('Mở khóa tài khoản @user.UserName?');">
                                                    <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"/></svg>
                                                </button>
                                            }
                                        </form>

                                        <!-- Nút Xóa -->
                                        <form method="post" asp-page-handler="DeleteUser" asp-route-userId="@user.Id" class="d-inline">
                                            <button type="submit" class="admin-action-btn delete" title="Xóa tài khoản"
                                                    onclick="return confirm('Bạn có chắc chắn muốn xóa tài khoản @user.UserName? Nếu tài khoản đã có đơn hàng thì hệ thống sẽ chuyển sang Khóa nick.');">
                                                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= MODAL THÊM TÀI KHOẢN MỚI ================= -->
<div class="modal fade" id="createAccountModal" tabindex="-1" aria-labelledby="createAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header bg-light border-bottom px-4 py-3">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="createAccountModalLabel">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                    </svg>
                    <span>Thêm Tài Khoản Mới</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="CreateUser">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Tên đăng nhập (Username) <span class="text-danger">*</span></label>
                        <input type="text" name="username" class="form-control form-control-admin" placeholder="Ví dụ: nhanvien_sales" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Mật khẩu ban đầu <span class="text-danger">*</span></label>
                        <input type="password" name="password" class="form-control form-control-admin" placeholder="Tối thiểu 6 ký tự" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Họ và tên</label>
                        <input type="text" name="fullName" class="form-control form-control-admin" placeholder="Ví dụ: Nguyễn Văn A" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Email</label>
                            <input type="email" name="email" class="form-control form-control-admin" placeholder="email@domain.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Số điện thoại</label>
                            <input type="tel" name="phone" class="form-control form-control-admin" placeholder="0901234567" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Địa chỉ</label>
                        <input type="text" name="address" class="form-control form-control-admin" placeholder="Ví dụ: 123 Lê Lợi, Q.1, TP.HCM" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-dark">Vai trò hệ thống <span class="text-danger">*</span></label>
                        <select name="role" class="form-select form-control-admin">
                            <option value="Customer" selected>Khách hàng (Customer)</option>
                            <option value="Admin">Quản trị viên (Admin)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top px-4 py-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-4 py-2 fw-semibold" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 py-2 fw-semibold shadow-sm">
                        <span>Tạo Tài Khoản</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= MODAL SỬA TÀI KHOẢN ================= -->
<div class="modal fade" id="editAccountModal" tabindex="-1" aria-labelledby="editAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header bg-light border-bottom px-4 py-3">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="editAccountModalLabel">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                    <span id="editModalTitle">Cập Nhật Tài Khoản</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="UpdateUser">
                <div class="modal-body p-4">
                    <input type="hidden" id="editUserId" name="userId" />

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Tên đăng nhập (Username)</label>
                        <input type="text" id="editUsername" class="form-control form-control-admin bg-light text-muted" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Họ và tên</label>
                        <input type="text" id="editFullName" name="fullName" class="form-control form-control-admin" placeholder="Ví dụ: Nguyễn Văn A" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Email</label>
                            <input type="email" id="editEmail" name="email" class="form-control form-control-admin" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Số điện thoại</label>
                            <input type="tel" id="editPhone" name="phone" class="form-control form-control-admin" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Địa chỉ</label>
                        <input type="text" id="editAddress" name="address" class="form-control form-control-admin" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-dark">Vai trò hệ thống <span class="text-danger">*</span></label>
                        <select id="editRole" name="role" class="form-select form-control-admin">
                            <option value="Customer">Khách hàng (Customer)</option>
                            <option value="Admin">Quản trị viên (Admin)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top px-4 py-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-4 py-2 fw-semibold" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 py-2 fw-semibold shadow-sm">
                        <span>Lưu Thay Đổi</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let createAccountModalInstance = null;
    let editAccountModalInstance = null;

    document.addEventListener("DOMContentLoaded", function () {
        var createEl = document.getElementById('createAccountModal');
        if (createEl) createAccountModalInstance = new bootstrap.Modal(createEl);

        var editEl = document.getElementById('editAccountModal');
        if (editEl) editAccountModalInstance = new bootstrap.Modal(editEl);
    });

    function openCreateAccountModal() {
        if (createAccountModalInstance) createAccountModalInstance.show();
    }

    function openEditAccountModal(id, username, fullname, email, phone, address, role) {
        document.getElementById('editModalTitle').innerText = 'Cập Nhật Tài Khoản: ' + username;
        document.getElementById('editUserId').value = id;
        document.getElementById('editUsername').value = username;
        document.getElementById('editFullName').value = fullname;
        document.getElementById('editEmail').value = email;
        document.getElementById('editPhone').value = phone;
        document.getElementById('editAddress').value = address;
        document.getElementById('editRole').value = role;
        if (editAccountModalInstance) editAccountModalInstance.show();
    }

    function toggleClearAccountSearch(val) {
        const btn = document.getElementById('btnClearAccountSearch');
        if (btn) btn.disabled = (!val || val.trim().length === 0);
    }

    function clearAccountSearch() {
        const input = document.getElementById('accountSearchInput');
        if (input) input.value = '';
        const form = document.getElementById('accountSearchForm');
        if (form) form.submit();
    }
</script>
}
