@inject ElectronicStore_mvc.Services.CartService CartService
@inject Microsoft.AspNetCore.Identity.UserManager<ElectronicStore_mvc.Models.Entities.ApplicationUser> UserManager
@{
    var currentUser = (User.Identity != null && User.Identity.IsAuthenticated) ? await UserManager.GetUserAsync(User) : null;
    var displayFullName = !string.IsNullOrWhiteSpace(currentUser?.FullName) ? currentUser.FullName : (User.Identity?.Name ?? "Thành viên");
    var displayEmail = !string.IsNullOrWhiteSpace(currentUser?.Email) ? currentUser.Email : "Tài khoản thành viên";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ElectroStore | Thế Giới Thiết Bị Điện Tử Đỉnh Cao</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    @Html.AntiForgeryToken()

    <!-- ================= 1. TOP UTILITY BAR ================= -->
    <div class="top-utility-bar">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <span>Công nghệ chính hãng. Trải nghiệm xứng tầm.</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span>Miễn phí giao hàng toàn quốc</span>
                <span>•</span>
                <a href="tel:18006868" class="fw-semibold text-white">Hotline 1800 6868</a>
            </div>
        </div>
    </div>

    <!-- ================= 2. MAIN NAVBAR ================= -->
    <header class="electro-navbar">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between gap-3">
                <!-- Logo -->
                <a class="brand-logo" asp-controller="Home" asp-action="Index">
                    <div class="brand-bolt-badge">
                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                        </svg>
                    </div>
                    <span>Electro<span style="color:var(--accent-blue);">Store</span></span>
                </a>

                <!-- Search Pill Input -->
                <form method="get" asp-controller="Home" asp-action="Index" class="search-pill-container d-none d-md-block flex-grow-1 mx-4">
                    <svg class="search-pill-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input type="text" name="SearchKeyword" class="search-pill-input" placeholder="Tìm sản phẩm, thương hiệu, cấu hình..."
                           value="@(Context.Request.Query["SearchKeyword"])" />
                    <span class="search-pill-shortcut">⌘ K</span>
                </form>

                <!-- Right Actions: Account & Cart -->
                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="dropdown">
                            <button class="nav-user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                                <span class="d-none d-lg-inline text-truncate" style="max-width: 140px;">
                                    Xin chào, <strong class="text-dark">@displayFullName</strong>
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius:12px; margin-top:8px;">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-bold text-dark">@displayFullName</div>
                                    <div class="small text-secondary">@displayEmail</div>
                                </li>
                                <li><a class="dropdown-item py-2 fw-semibold" asp-controller="Orders" asp-action="MyOrders">Đơn hàng của tôi</a></li>
                                <li><a class="dropdown-item py-2 fw-semibold" asp-controller="Account" asp-action="Profile">Thông tin tài khoản</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 fw-semibold text-primary" asp-area="Admin" asp-controller="Admin" asp-action="Products">Quản trị: Sản phẩm</a></li>
                                    <li><a class="dropdown-item py-2 fw-semibold text-primary" asp-area="Admin" asp-controller="Admin" asp-action="Orders">Quản trị: Đơn hàng</a></li>
                                    <li><a class="dropdown-item py-2 fw-semibold text-primary" asp-area="Admin" asp-controller="Admin" asp-action="Categories">Quản trị: Danh mục</a></li>
                                    <li><a class="dropdown-item py-2 fw-semibold text-primary" asp-area="Admin" asp-controller="Admin" asp-action="Accounts">Quản trị: Tài khoản</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 text-danger fw-semibold" asp-controller="Account" asp-action="Logout">Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="nav-user-btn">
                            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                            <span class="d-none d-sm-inline">Tài khoản</span>
                        </a>
                    }

                    <!-- Cart button -->
                    @{
                        var cartCount = CartService.GetCount();
                    }
                    <a asp-controller="Cart" asp-action="Index" class="nav-cart-btn">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                        </svg>
                        <span class="d-none d-sm-inline">Giỏ hàng</span>
                        <!-- Badge số lượng giỏ hàng hỗ trợ cập nhật realtime qua JS -->
                        <span class="nav-cart-badge" id="cart-count-badge">@cartCount</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- ================= 3. SUB-NAV CATEGORY BAR ================= -->
    <nav class="subnav-bar">
        <div class="container d-flex justify-content-between align-items-center overflow-auto">
            <div class="d-flex align-items-center gap-1 py-1">
                <a class="subnav-link" asp-controller="Home" asp-action="Index" asp-route-CategoryId="1">Điện thoại</a>
                <a class="subnav-link" asp-controller="Home" asp-action="Index" asp-route-CategoryId="2">Laptop</a>
                <a class="subnav-link" asp-controller="Home" asp-action="Index" asp-route-CategoryId="3">Máy tính bảng</a>
                <a class="subnav-link" asp-controller="Home" asp-action="Index" asp-route-CategoryId="4">Âm thanh</a>
                <a class="subnav-link" asp-controller="Home" asp-action="Index" asp-route-CategoryId="5">Phụ kiện</a>
            </div>
            <div class="d-none d-md-block">
                <a class="subnav-promo" asp-controller="Home" asp-action="Index" asp-route-tag="deal">
                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2l2.4 7.4H22l-6 4.6 2.3 7.2-6.3-4.6-6.3 4.6 2.3-7.2-6-4.6h7.6z"/>
                    </svg>
                    <span>Ưu đãi hôm nay</span>
                </a>
            </div>
        </div>
    </nav>

    <!-- ================= 4. MAIN CONTENT ================= -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Container cho Toast thông báo -->
    <div id="toast-container"></div>

    <!-- ================= 5. DARK FOOTER ================= -->
    <footer class="electro-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <!-- Col 1: Brand & Hotline -->
                <div class="col-lg-4 col-md-6">
                    <div class="brand-logo mb-3">
                        <div class="brand-bolt-badge">
                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                            </svg>
                        </div>
                        <span class="text-white">Electro<span style="color:var(--accent-blue);">Store.</span></span>
                    </div>
                    <p class="text-secondary small mb-3" style="max-width:320px; line-height: 1.6;">
                        Công nghệ bạn yêu. Dịch vụ bạn tin. Đồng hành cùng mọi trải nghiệm số.
                    </p>
                    <div class="footer-hotline">1800 6868</div>
                    <div class="small text-secondary">8:00 – 21:00 mỗi ngày • Tư vấn miễn phí</div>
                </div>

                <!-- Col 2: Khám phá -->
                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="text-white fw-bold mb-3">Khám phá</h6>
                    <div><a class="footer-nav-link" asp-controller="Home" asp-action="Index">Về ElectroStore</a></div>
                    <div><a class="footer-nav-link" asp-controller="Home" asp-action="Index">Hệ thống cửa hàng</a></div>
                    <div><a class="footer-nav-link" asp-controller="Home" asp-action="Index">Tin công nghệ</a></div>
                    <div><a class="footer-nav-link" asp-controller="Home" asp-action="Index">Tuyển dụng</a></div>
                </div>

                <!-- Col 3: Hỗ trợ khách hàng -->
                <div class="col-6 col-md-3 col-lg-3">
                    <h6 class="text-white fw-bold mb-3">Hỗ trợ khách hàng</h6>
                    <div><a class="footer-nav-link" asp-controller="Home" asp-action="Index">Giao hàng & thanh toán</a></div>
                    <div><a class="footer-nav-link" asp-controller="Home" asp-action="Index">Bảo hành & đổi trả</a></div>
                    <div><a class="footer-nav-link" asp-controller="Orders" asp-action="MyOrders">Tra cứu đơn hàng</a></div>
                    <div><a class="footer-nav-link" asp-controller="Home" asp-action="Index">Câu hỏi thường gặp</a></div>
                </div>

                <!-- Col 4: Kết nối với chúng tôi -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Kết nối với chúng tôi</h6>
                    <div><a class="footer-nav-link" href="mailto:hello@electrostore.vn">hello@electrostore.vn</a></div>
                    <div><a class="footer-nav-link" href="https://facebook.com" target="_blank">Facebook / Instagram</a></div>
                    <div class="mt-2 text-secondary small">Thanh toán an toàn 100%</div>
                    <div class="d-flex gap-2 mt-2">
                        <span class="badge bg-dark border border-secondary text-secondary">COD</span>
                        <span class="badge bg-dark border border-secondary text-secondary">VietQR</span>
                        <span class="badge bg-dark border border-secondary text-secondary">VNPAY</span>
                        <span class="badge bg-dark border border-secondary text-secondary">MOMO</span>
                    </div>
                </div>
            </div>

            <!-- Bottom Copyright & Policies -->
            <div class="border-top border-secondary border-opacity-25 pt-4 d-flex flex-wrap justify-content-between align-items-center small text-secondary">
                <div>&copy; @DateTime.Now.Year ElectroStore. Bảo lưu mọi quyền.</div>
                <div class="d-flex align-items-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="footer-nav-link mb-0">Chính sách bảo mật</a>
                    <span>•</span>
                    <a asp-controller="Home" asp-action="Index" class="footer-nav-link mb-0">Điều khoản sử dụng</a>
                    <span>•</span>
                    <a href="/Admin/Login" class="footer-nav-link mb-0 text-white-hover">
                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-1">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                        Cổng Quản Trị
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
