@page "/account/register"
@page "/register"
@using Microsoft.AspNetCore.Identity
@using ElectronicStore_blazor.Models.Entities
@inject UserManager<ApplicationUser> UserManager
@inject UserService UserService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Tạo Tài Khoản Mới - ElectroStore</PageTitle>

<div class="container py-3">
    <!-- Breadcrumb -->
    <nav class="mb-3" style="--bs-breadcrumb-divider: '›';">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a href="" class="text-secondary text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Đăng ký tài khoản</li>
        </ol>
    </nav>

    <!-- Split Card Container -->
    <div class="auth-split-container">
        <!-- Cột trái: Marketing Visual Card -->
        <div class="auth-split-visual">
            <div>
                <div class="hero-titanium-badge mb-3">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24" class="me-1">
                        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                    </svg>
                    <span>KẾT NỐI VỚI ĐIỀU BẠN YÊU</span>
                </div>
                <h2 class="fw-bold text-white mb-3" style="font-size:2.2rem; line-height: 1.15; letter-spacing:-0.03em;">
                    Một tài khoản.<br/>
                    Mở mọi trải nghiệm.
                </h2>
                <p class="text-secondary small mb-4" style="line-height: 1.6;">
                    Mua sắm dễ dàng, theo dõi đơn hàng và đón những ưu đãi dành riêng cho bạn.
                </p>
            </div>

            <div class="my-3 text-center">
                <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e" 
                     alt="Tech showcase" class="img-fluid rounded-4 shadow" style="max-height: 220px; width: 100%; object-fit: cover; opacity: 0.85;" />
            </div>

            <div class="d-flex align-items-center gap-4 text-secondary small pt-3 border-top border-secondary border-opacity-25">
                <span>✓ Chính hãng 100%</span>
                <span>✓ Bảo mật thông tin</span>
            </div>
        </div>

        <!-- Cột phải: Form Đăng ký -->
        <div class="auth-split-form d-flex flex-column justify-content-center">
            <div class="mb-4">
                <span class="text-primary fw-bold small text-uppercase" style="letter-spacing:0.05em;">Gia nhập ElectroStore</span>
                <h3 class="fw-bold text-dark mb-1" style="font-size:1.8rem; letter-spacing:-0.02em;">Tạo tài khoản mới</h3>
                <p class="text-secondary small mb-0">Bắt đầu trải nghiệm mua sắm theo cách của bạn.</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger rounded-3 py-2 small mb-3">
                    @errorMessage
                </div>
            }

            <form @onsubmit="HandleRegister">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Tên đăng nhập *</label>
                    <input type="text" @bind="username" class="form-control form-control-custom" placeholder="Ví dụ: nguyenvana" autofocus required />
                    <div class="small text-secondary mt-1" style="font-size:0.75rem;">Viết liền, không dấu; chỉ dùng chữ, số và dấu gạch dưới.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Email *</label>
                    <input type="email" @bind="email" class="form-control form-control-custom" placeholder="an.nguyen@example.com" required />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Mật khẩu *</label>
                        <input type="password" @bind="password" class="form-control form-control-custom" placeholder="••••••••" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Số điện thoại *</label>
                        <input type="tel" @bind="phoneNumber" class="form-control form-control-custom" placeholder="0901 234 567" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Họ và tên *</label>
                    <input type="text" @bind="fullName" class="form-control form-control-custom" placeholder="Nguyễn Văn An" required />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Địa chỉ giao hàng</label>
                    <input type="text" @bind="address" class="form-control form-control-custom" placeholder="123 Nguyễn Huệ, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh" />
                    <div class="small text-secondary mt-1" style="font-size:0.75rem;">Nhập đầy đủ địa chỉ để giao hàng chính xác.</div>
                </div>

                <div class="mb-4">
                    <label class="d-flex align-items-center gap-2 text-secondary small cursor-pointer">
                        <input type="checkbox" class="form-check-input" required checked />
                        <span>Tôi đồng ý với Điều khoản sử dụng và Chính sách bảo mật của ElectroStore.</span>
                    </label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-3 d-flex align-items-center justify-content-center gap-2 mb-3"
                        style="background:var(--accent-blue); border:none;">
                    <span>Tạo tài khoản</span>
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                </button>

                <div class="text-center text-secondary small">
                    Đã có tài khoản? <a href="@(string.IsNullOrEmpty(returnUrl) ? "account/login" : $"account/login?returnUrl={returnUrl}")" class="text-primary text-decoration-none fw-semibold">Đăng nhập</a>
                </div>
            </form>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? returnUrl { get; set; }

    private string username = "";
    private string password = "";
    private string fullName = "";
    private string phoneNumber = "";
    private string email = "";
    private string address = "";
    private string errorMessage = "";

    private async Task HandleRegister()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password) || 
            string.IsNullOrWhiteSpace(fullName) || string.IsNullOrWhiteSpace(phoneNumber))
        {
            errorMessage = "Vui lòng điền đầy đủ các thông tin bắt buộc (*)!";
            return;
        }

        var existingUser = await UserManager.FindByNameAsync(username.Trim());
        if (existingUser != null)
        {
            errorMessage = "Tên đăng nhập này đã được sử dụng. Vui lòng chọn tên khác!";
            return;
        }

        var user = new ApplicationUser
        {
            UserName = username.Trim(),
            FullName = fullName.Trim(),
            PhoneNumber = phoneNumber.Trim(),
            Email = string.IsNullOrWhiteSpace(email) ? $"{username.Trim()}@electrostore.vn" : email.Trim(),
            Address = string.IsNullOrWhiteSpace(address) ? "Chưa cập nhật địa chỉ" : address.Trim(),
            IsActive = true,
            CreatedAt = DateTime.Now
        };

        var result = await UserManager.CreateAsync(user, password.Trim());
        if (result.Succeeded)
        {
            await UserManager.AddToRoleAsync(user, "Customer");
            await UserService.LoginAsync(username.Trim(), password.Trim(), JS);
            if (!string.IsNullOrEmpty(returnUrl))
            {
                Navigation.NavigateTo(returnUrl);
            }
            else
            {
                Navigation.NavigateTo("");
            }
            return;
        }

        errorMessage = string.Join("; ", result.Errors.Select(e => e.Description));
    }
}
