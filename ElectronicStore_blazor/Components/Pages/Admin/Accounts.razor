@page "/admin/accounts"
@layout AdminLayout
@inject IProductService ProductService
@inject UserService UserService
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject IDbContextFactory<ElectronicStore_blazor.Data.ElectronicStoreDbContext> DbFactory
@inject IJSRuntime JS
@using Microsoft.EntityFrameworkCore

<PageTitle>Admin - Quản Lý Tài Khoản - ElectroStore</PageTitle>

<div class="container-fluid p-0">
    <!-- Tiêu Đề & Nút Thêm Mới -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <span>Quản Lý Tài Khoản & Khách Hàng</span>
                <span class="badge bg-primary rounded-pill fs-6 px-3">@users.Count tài khoản</span>
            </h3>
            <p class="text-secondary small mb-0">Theo dõi danh sách thành viên, quản lý vai trò và phân quyền khóa / mở khóa tài khoản.</p>
        </div>
        <div>
            <button type="button" class="btn btn-primary rounded-3 px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm"
                    @onclick="OpenCreateModal">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
                <span>Thêm Tài Khoản Mới</span>
            </button>
        </div>
    </div>

    <!-- Thông báo Alert -->
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert alert-@(alertType ?? "success") alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                </svg>
                <div>@alertMessage</div>
            </div>
            <button type="button" class="btn-close" @onclick="() => alertMessage = null" aria-label="Close"></button>
        </div>
    }

    <!-- ================= 1. KPI SUMMARY CARDS ================= -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Tổng người dùng</div>
                    <div class="stat-value">@users.Count</div>
                    <div class="stat-subtext">Trong hệ thống</div>
                </div>
                <div class="stat-icon-wrap blue">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Khách hàng</div>
                    <div class="stat-value text-success">@users.Count(u => userRoles.GetValueOrDefault(u.Id, "Customer") != "Admin")</div>
                    <div class="stat-subtext">Tài khoản thành viên</div>
                </div>
                <div class="stat-icon-wrap green">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Quản trị viên</div>
                    <div class="stat-value text-primary">@users.Count(u => userRoles.GetValueOrDefault(u.Id, "Customer") == "Admin")</div>
                    <div class="stat-subtext">Quyền hạn tối cao</div>
                </div>
                <div class="stat-icon-wrap purple">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Tài khoản bị khóa</div>
                    <div class="stat-value text-danger">@users.Count(u => !u.IsActive)</div>
                    <div class="stat-subtext">Bị cấm truy cập</div>
                </div>
                <div class="stat-icon-wrap red">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= 2. THANH TÌM KIẾM ================= -->
    <div class="admin-card mb-4">
        <div class="admin-card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-9 col-lg-10">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                            </svg>
                        </span>
                        <input type="text" @bind="searchKeyword" @bind:event="oninput"
                               class="form-control form-control-admin border-start-0 ps-0" 
                               placeholder="Tìm theo tên đăng nhập, họ tên, email hoặc số điện thoại..." />
                    </div>
                </div>
                <div class="col-md-3 col-lg-2 d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-3 w-100 py-2 fw-semibold"
                            @onclick='() => searchKeyword = ""' disabled="@string.IsNullOrWhiteSpace(searchKeyword)">
                        Xóa tìm kiếm
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= 3. BẢNG TÀI KHOẢN ================= -->
    <div class="admin-card mb-4">
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="ps-4">Tài Khoản</th>
                        <th>Phân Quyền</th>
                        <th>Họ Và Tên</th>
                        <th>Số Điện Thoại</th>
                        <th>Email & Địa Chỉ</th>
                        <th>Ngày Tham Gia</th>
                        <th>Trạng Thái</th>
                        <th class="pe-4 text-end">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredUsers.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-secondary">
                                <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="mb-2 text-muted">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                                </svg>
                                <div>Không tìm thấy tài khoản nào phù hợp với từ khóa!</div>
                            </td>
                        </tr>
                    }
                    @foreach (var user in FilteredUsers)
                    {
                        var role = userRoles.GetValueOrDefault(user.Id, "Customer");
                        <tr @key="user.Id">
                            <!-- Username -->
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2.5">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm"
                                         style="width: 36px; height: 36px; background: linear-gradient(135deg, #2563eb, #3b82f6); font-size: 0.85rem;">
                                        @(user.UserName?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <div>
                                        <div class="text-dark fw-bold">@user.UserName</div>
                                    </div>
                                </div>
                            </td>

                            <!-- Role -->
                            <td>
                                @if (role == "Admin")
                                {
                                    <span class="badge bg-warning text-dark fw-bold px-2.5 py-1.5" style="font-size:0.75rem;">QUẢN TRỊ VIÊN</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary border fw-medium px-2.5 py-1.5" style="font-size:0.75rem;">Khách Hàng</span>
                                }
                            </td>

                            <!-- FullName Info -->
                            <td>
                                <div class="text-dark fw-semibold">@(user.FullName ?? "Chưa cập nhật")</div>
                            </td>

                            <!-- Phone -->
                            <td>
                                <span class="small text-secondary">@(user.PhoneNumber ?? "—")</span>
                            </td>

                            <!-- Email & Address -->
                            <td>
                                <div class="text-dark small">@(user.Email ?? "—")</div>
                                <div class="text-secondary small text-truncate" style="max-width:200px;" title="@user.Address">@(user.Address ?? "—")</div>
                            </td>

                            <!-- Created Date -->
                            <td>
                                <span class="small text-secondary">@user.CreatedAt.ToString("dd/MM/yyyy")</span>
                            </td>

                            <!-- Status -->
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small fw-semibold">
                                        Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 small fw-semibold">
                                        ĐÃ KHÓA
                                    </span>
                                }
                            </td>

                            <!-- Actions -->
                            <td class="pe-4 text-end">
                                <div class="d-inline-flex gap-1 align-items-center">
                                    <!-- Nút Sửa -->
                                    <button type="button" class="admin-action-btn edit" title="Sửa tài khoản"
                                            @onclick="() => OpenEditModal(user, role)">
                                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                    </button>

                                    <!-- Nút Khóa / Mở Khóa -->
                                    @if (user.UserName != UserService.CurrentUser?.UserName)
                                    {
                                        @if (user.IsActive)
                                        {
                                            <button type="button" class="admin-action-btn delete" title="Khóa tài khoản"
                                                    @onclick="() => ToggleLock(user)">
                                                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="admin-action-btn edit" title="Mở khóa tài khoản" style="color:#10b981; border-color:#86efac; background:#f0fdf4;"
                                                    @onclick="() => ToggleLock(user)">
                                                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"/></svg>
                                            </button>
                                        }

                                        <!-- Nút Xóa -->
                                        <button type="button" class="admin-action-btn delete" title="Xóa tài khoản"
                                                @onclick="() => DeleteUser(user)">
                                            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= MODAL THÊM TÀI KHOẢN MỚI ================= -->
@if (showCreateModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(0, 0, 0, 0.4);">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header bg-light border-bottom px-4 py-3">
                    <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                        </svg>
                        <span>Thêm Tài Khoản Mới</span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showCreateModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Tên đăng nhập (Username) <span class="text-danger">*</span></label>
                        <input type="text" @bind="newUsername" @bind:event="oninput" class="form-control form-control-admin" placeholder="Ví dụ: nhanvien_sales" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Mật khẩu ban đầu <span class="text-danger">*</span></label>
                        <input type="password" @bind="newPassword" @bind:event="oninput" class="form-control form-control-admin" placeholder="Tối thiểu 6 ký tự" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Họ và tên</label>
                        <input type="text" @bind="newFullName" @bind:event="oninput" class="form-control form-control-admin" placeholder="Ví dụ: Nguyễn Văn A" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Email</label>
                            <input type="email" @bind="newEmail" @bind:event="oninput" class="form-control form-control-admin" placeholder="email@domain.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Số điện thoại</label>
                            <input type="tel" @bind="newPhone" @bind:event="oninput" class="form-control form-control-admin" placeholder="0901234567" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Địa chỉ</label>
                        <input type="text" @bind="newAddress" @bind:event="oninput" class="form-control form-control-admin" placeholder="Ví dụ: 123 Lê Lợi, Q.1, TP.HCM" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-dark">Vai trò hệ thống <span class="text-danger">*</span></label>
                        <select @bind="newRole" class="form-select form-control-admin">
                            <option value="Customer">Khách hàng (Customer)</option>
                            <option value="Admin">Quản trị viên (Admin)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top px-4 py-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-4 py-2 fw-semibold" @onclick="() => showCreateModal = false">Hủy bỏ</button>
                    <button type="button" class="btn btn-primary rounded-3 px-4 py-2 fw-semibold shadow-sm" @onclick="HandleCreateUser">
                        <span>Tạo Tài Khoản</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL SỬA TÀI KHOẢN ================= -->
@if (showEditModal && editingUser != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(0, 0, 0, 0.4);">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header bg-light border-bottom px-4 py-3">
                    <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                        <span>Cập Nhật Tài Khoản: @editingUser.UserName</span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showEditModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Tên đăng nhập (Username)</label>
                        <input type="text" value="@editingUser.UserName" class="form-control form-control-admin bg-light text-muted" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Họ và tên</label>
                        <input type="text" @bind="editFullName" @bind:event="oninput" class="form-control form-control-admin" placeholder="Ví dụ: Nguyễn Văn A" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Email</label>
                            <input type="email" @bind="editEmail" @bind:event="oninput" class="form-control form-control-admin" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Số điện thoại</label>
                            <input type="tel" @bind="editPhone" @bind:event="oninput" class="form-control form-control-admin" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Địa chỉ</label>
                        <input type="text" @bind="editAddress" @bind:event="oninput" class="form-control form-control-admin" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-dark">Vai trò hệ thống <span class="text-danger">*</span></label>
                        <select @bind="editRole" class="form-select form-control-admin">
                            <option value="Customer">Khách hàng (Customer)</option>
                            <option value="Admin">Quản trị viên (Admin)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top px-4 py-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-4 py-2 fw-semibold" @onclick="() => showEditModal = false">Hủy bỏ</button>
                    <button type="button" class="btn btn-primary rounded-3 px-4 py-2 fw-semibold shadow-sm" @onclick="HandleUpdateUser">
                        <span>Lưu Thay Đổi</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ApplicationUser> users = new();
    private Dictionary<string, string> userRoles = new();
    private string searchKeyword = "";
    private string? alertMessage;
    private string? alertType;

    // Create Modal state
    private bool showCreateModal = false;
    private string newUsername = "";
    private string newPassword = "";
    private string newFullName = "";
    private string newEmail = "";
    private string newPhone = "";
    private string newAddress = "";
    private string newRole = "Customer";

    // Edit Modal state
    private bool showEditModal = false;
    private ApplicationUser? editingUser;
    private string editFullName = "";
    private string editEmail = "";
    private string editPhone = "";
    private string editAddress = "";
    private string editRole = "Customer";

    private IEnumerable<ApplicationUser> FilteredUsers =>
        string.IsNullOrWhiteSpace(searchKeyword)
            ? users
            : users.Where(u => (u.UserName != null && u.UserName.Contains(searchKeyword.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                               (u.FullName != null && u.FullName.Contains(searchKeyword.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                               (u.Email != null && u.Email.Contains(searchKeyword.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                               (u.PhoneNumber != null && u.PhoneNumber.Contains(searchKeyword.Trim())));

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        users = UserManager.Users.OrderByDescending(u => u.CreatedAt).ToList();
        userRoles.Clear();
        foreach (var u in users)
        {
            var roles = await UserManager.GetRolesAsync(u);
            userRoles[u.Id] = roles.FirstOrDefault() ?? "Customer";
        }
    }

    private void OpenCreateModal()
    {
        newUsername = "";
        newPassword = "";
        newFullName = "";
        newEmail = "";
        newPhone = "";
        newAddress = "";
        newRole = "Customer";
        showCreateModal = true;
    }

    private async Task HandleCreateUser()
    {
        if (newRole is not ("Customer" or "Admin"))
        {
            alertMessage = "Vai trò tài khoản không hợp lệ.";
            alertType = "danger";
            return;
        }

        if (string.IsNullOrWhiteSpace(newUsername) || string.IsNullOrWhiteSpace(newPassword))
        {
            alertMessage = "Tên đăng nhập và mật khẩu không được để trống!";
            alertType = "danger";
            return;
        }

        var existing = await UserManager.FindByNameAsync(newUsername.Trim());
        if (existing != null)
        {
            alertMessage = $"Tên đăng nhập '{newUsername}' đã tồn tại!";
            alertType = "danger";
            return;
        }

        var user = new ApplicationUser
        {
            UserName = newUsername.Trim(),
            FullName = string.IsNullOrWhiteSpace(newFullName) ? newUsername.Trim() : newFullName.Trim(),
            Email = newEmail.Trim(),
            PhoneNumber = newPhone.Trim(),
            Address = newAddress.Trim(),
            IsActive = true,
            CreatedAt = DateTime.UtcNow
        };

        var result = await UserManager.CreateAsync(user, newPassword.Trim());
        if (!result.Succeeded)
        {
            alertMessage = "Lỗi khi tạo tài khoản: " + string.Join("; ", result.Errors.Select(e => e.Description));
            alertType = "danger";
            return;
        }

        var roleResult = await UserManager.AddToRoleAsync(user, newRole);
        if (!roleResult.Succeeded)
        {
            await UserManager.DeleteAsync(user);
            alertMessage = "Không thể gán vai trò cho tài khoản: " +
                           string.Join("; ", roleResult.Errors.Select(e => e.Description));
            alertType = "danger";
            return;
        }

        alertMessage = $"Đã tạo thành công tài khoản '{user.UserName}' với vai trò '{newRole}'!";
        alertType = "success";
        showCreateModal = false;
        await LoadUsers();
    }

    private void OpenEditModal(ApplicationUser user, string role)
    {
        editingUser = user;
        editFullName = user.FullName ?? "";
        editEmail = user.Email ?? "";
        editPhone = user.PhoneNumber ?? "";
        editAddress = user.Address ?? "";
        editRole = role;
        showEditModal = true;
    }

    private async Task HandleUpdateUser()
    {
        if (editingUser == null) return;

        if (editRole is not ("Customer" or "Admin"))
        {
            alertMessage = "Vai trò tài khoản không hợp lệ.";
            alertType = "danger";
            return;
        }

        // Chặn Admin tự tước quyền quản trị của chính mình
        if (editingUser.UserName == UserService.CurrentUser?.UserName && editRole != "Admin")
        {
            alertMessage = "Bạn không thể tự hạ quyền Quản trị viên của chính mình!";
            alertType = "warning";
            return;
        }

        editingUser.FullName = editFullName.Trim();
        editingUser.Email = editEmail.Trim();
        editingUser.PhoneNumber = editPhone.Trim();
        editingUser.Address = editAddress.Trim();

        await UserManager.UpdateAsync(editingUser);

        var currentRoles = await UserManager.GetRolesAsync(editingUser);
        if (!currentRoles.Contains(editRole))
        {
            await UserManager.RemoveFromRolesAsync(editingUser, currentRoles);
            var roleResult = await UserManager.AddToRoleAsync(editingUser, editRole);
            if (!roleResult.Succeeded)
            {
                alertMessage = "Không thể cập nhật vai trò: " +
                               string.Join("; ", roleResult.Errors.Select(e => e.Description));
                alertType = "danger";
                return;
            }
        }

        alertMessage = $"Đã cập nhật thông tin tài khoản '{editingUser.UserName}'!";
        alertType = "success";
        showEditModal = false;
        await LoadUsers();
    }

    private async Task DeleteUser(ApplicationUser user)
    {
        if (user.UserName == UserService.CurrentUser?.UserName)
        {
            alertMessage = "Bạn không thể tự xóa tài khoản Admin của chính mình!";
            alertType = "warning";
            return;
        }

        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Bạn có chắc chắn muốn xóa tài khoản {user.UserName}?");
        if (!confirmed) return;

        using var context = DbFactory.CreateDbContext();
        bool hasOrders = await context.Orders.AnyAsync(o => o.UserId == user.Id);

        if (hasOrders)
        {
            user.IsActive = false;
            await UserManager.UpdateAsync(user);
            alertMessage = $"Tài khoản '{user.UserName}' đã có lịch sử đơn hàng. Hệ thống đã tự động chuyển sang trạng thái KHÓA TÀI KHOẢN để bảo toàn dữ liệu kế toán & hóa đơn.";
            alertType = "warning";
        }
        else
        {
            var res = await UserManager.DeleteAsync(user);
            if (res.Succeeded)
            {
                alertMessage = $"Đã xóa vĩnh viễn tài khoản '{user.UserName}'.";
                alertType = "success";
            }
            else
            {
                alertMessage = "Không thể xóa: " + string.Join("; ", res.Errors.Select(e => e.Description));
                alertType = "danger";
            }
        }

        await LoadUsers();
    }

    private async Task ToggleLock(ApplicationUser user)
    {
        if (user.UserName == UserService.CurrentUser?.UserName)
        {
            alertMessage = "Bạn không thể tự khóa tài khoản Admin của chính mình!";
            alertType = "warning";
            return;
        }

        user.IsActive = !user.IsActive;
        var result = await UserManager.UpdateAsync(user);
        if (result.Succeeded)
        {
            alertMessage = $"Đã {(user.IsActive ? "MỞ KHÓA" : "KHÓA")} tài khoản {user.UserName}!";
            alertType = user.IsActive ? "success" : "danger";
        }
        else
        {
            alertMessage = "Không thể cập nhật trạng thái tài khoản: " + string.Join("; ", result.Errors.Select(e => e.Description));
            alertType = "danger";
        }
        await LoadUsers();
    }
}
