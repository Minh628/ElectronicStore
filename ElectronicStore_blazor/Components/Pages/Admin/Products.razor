@page "/admin/products"
@layout AdminLayout
@inject IProductService ProductService
@inject IJSRuntime JS

<PageTitle>Admin - Quản Lý Sản Phẩm - ElectroStore</PageTitle>

<div class="container-fluid p-0">
    <!-- Tiêu Đề & Hành Động Chính -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <span>Quản Lý Sản Phẩm</span>
                <span class="badge bg-primary rounded-pill fs-6 px-3">@totalCount thiết bị</span>
            </h3>
            <p class="text-secondary small mb-0">Quản lý kho hàng, cập nhật giá bán, cấu hình chi tiết và trạng thái kinh doanh.</p>
        </div>
        <div>
            <button type="button" class="btn btn-primary rounded-3 px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm"
                    @onclick="OpenAddModal">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span>Thêm Thiết Bị Mới</span>
            </button>
        </div>
    </div>

    <!-- Thông báo Alert -->
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert alert-@(alertType ?? "success") alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                </svg>
                <div>@alertMessage</div>
            </div>
            <button type="button" class="btn-close" @onclick="() => alertMessage = null" aria-label="Close"></button>
        </div>
    }

    <!-- ================= 1. KPI SUMMARY CARDS ================= -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Tổng thiết bị</div>
                    <div class="stat-value">@totalCount</div>
                    <div class="stat-subtext">Trong hệ thống</div>
                </div>
                <div class="stat-icon-wrap blue">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Còn hàng</div>
                    <div class="stat-value text-success">@products.Count(p => p.Quantity > 0)</div>
                    <div class="stat-subtext">Đang sẵn sàng giao</div>
                </div>
                <div class="stat-icon-wrap green">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Hết / Cảnh báo kho</div>
                    <div class="stat-value text-danger">@products.Count(p => p.Quantity <= 5)</div>
                    <div class="stat-subtext">Cần nhập thêm hàng</div>
                </div>
                <div class="stat-icon-wrap amber">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Ngành hàng</div>
                    <div class="stat-value text-primary">@categories.Count</div>
                    <div class="stat-subtext">Danh mục thiết bị</div>
                </div>
                <div class="stat-icon-wrap purple">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= 2. SEARCH & FILTER CONTROLS ================= -->
    <div class="admin-card mb-4">
        <div class="p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        </span>
                        <input type="text" @bind="searchKeyword" @bind:event="oninput" @onkeydown="HandleSearchKeyDown"
                               class="form-control form-control-admin border-start-0 ps-0" placeholder="Tìm theo tên máy, hãng..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select @bind="selectedCategoryId" class="form-select form-select-admin">
                        <option value="0">-- Tất cả danh mục --</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="button" class="btn btn-primary px-3 rounded-3 fw-semibold flex-grow-1" @onclick="ApplyFilter">
                        Lọc Dữ Liệu
                    </button>
                    <button type="button" class="btn btn-outline-secondary px-3 rounded-3" @onclick="ResetFilter">
                        Đặt lại
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= 3. PRODUCTS DATA TABLE ================= -->
    <div class="admin-card mb-4">
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="ps-4">Sản Phẩm</th>
                        <th>Hãng</th>
                        <th>Danh Mục</th>
                        <th>Đơn Giá</th>
                        <th>Tồn Kho</th>
                        <th>Bảo Hành</th>
                        <th>Trạng Thái</th>
                        <th class="pe-4 text-end">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (products.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-secondary">
                                <div class="py-3">
                                    <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-muted mb-2">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                                    </svg>
                                    <div class="fw-semibold">Không tìm thấy sản phẩm nào!</div>
                                    <div class="small">Hãy thử thay đổi từ khóa hoặc điều kiện lọc.</div>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var p in products)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9" : p.ImageUrl)"
                                         alt="@p.Name" class="admin-prod-thumb" />
                                    <div>
                                        <div class="text-dark fw-bold">@p.Name</div>
                                        <div class="text-secondary small text-truncate" style="max-width: 280px;">@p.Specifications</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border fw-semibold">@p.Brand</span>
                            </td>
                            <td>
                                <span class="text-secondary small fw-medium">@p.Category?.Name</span>
                            </td>
                            <td>
                                <span class="fw-bold text-dark">@p.Price.ToString("N0") ₫</span>
                            </td>
                            <td>
                                @if (p.Quantity > 10)
                                {
                                    <span class="badge-pill-stock instock">Còn @p.Quantity máy</span>
                                }
                                else if (p.Quantity > 0)
                                {
                                    <span class="badge-pill-stock lowstock">Sắp hết (@p.Quantity)</span>
                                }
                                else
                                {
                                    <span class="badge-pill-stock outstock">Hết hàng</span>
                                }
                            </td>
                            <td>
                                <span class="small text-secondary">@p.WarrantyMonths tháng</span>
                            </td>
                            <td>
                                <button type="button" class="border-0 bg-transparent p-0" title="Bấm để bật/tắt hiển thị" @onclick="() => ToggleActive(p)">
                                    @if (p.IsActive)
                                    {
                                        <span class="badge-pill-status completed">
                                            <span class="status-dot"></span>
                                            <span>Đang bán</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-pill-status cancelled">
                                            <span class="status-dot"></span>
                                            <span>Tạm ẩn</span>
                                        </span>
                                    }
                                </button>
                            </td>
                            <td class="pe-4 text-end">
                                <div class="d-inline-flex gap-1">
                                    <button type="button" class="admin-action-btn edit" title="Chỉnh sửa thiết bị" @onclick="() => OpenEditModal(p)">
                                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                    </button>
                                    <button type="button" class="admin-action-btn delete" title="Xóa thiết bị" @onclick="() => DeleteProduct(p.Id)">
                                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ================= 4. PHÂN TRANG ================= -->
    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-center gap-1 mb-4">
            <button type="button" class="btn btn-sm btn-white border rounded-3 px-3 @(currentPage <= 1 ? "disabled" : "")"
                    @onclick="() => ChangePage(currentPage - 1)">&laquo; Trước</button>

            @for (int i = 1; i <= totalPages; i++)
            {
                var pageNum = i;
                <button type="button" class="btn btn-sm rounded-3 px-3 fw-semibold @(currentPage == pageNum ? "btn-primary" : "btn-white border")"
                        @onclick="() => ChangePage(pageNum)">@pageNum</button>
            }

            <button type="button" class="btn btn-sm btn-white border rounded-3 px-3 @(currentPage >= totalPages ? "disabled" : "")"
                    @onclick="() => ChangePage(currentPage + 1)">Sau &raquo;</button>
        </div>
    }
</div>

<!-- ================= MODAL THÊM / SỬA SẢN PHẨM ================= -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header border-bottom py-3 px-4 bg-light">
                    <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        <span>@(inputProduct.Id == 0 ? "Thêm Thiết Bị Mới" : "Cập Nhật Thiết Bị")</span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-4">
                        <!-- Cột Trái: Thông tin cơ bản -->
                        <div class="col-lg-7">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">1. Thông Tin Cơ Bản</h6>
                            <div class="row g-3 mb-3">
                                <div class="col-12">
                                    <label class="form-label small fw-semibold text-dark">Tên thiết bị <span class="text-danger">*</span></label>
                                    <input type="text" @bind="inputProduct.Name" class="form-control form-control-admin" placeholder="Ví dụ: iPhone 16 Pro Max 256GB" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-dark">Hãng sản xuất <span class="text-danger">*</span></label>
                                    <input type="text" @bind="inputProduct.Brand" class="form-control form-control-admin" placeholder="Apple, Samsung, Sony..." required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-dark">Danh mục ngành hàng <span class="text-danger">*</span></label>
                                    <select @bind="inputProduct.CategoryId" class="form-select form-select-admin" required>
                                        @foreach (var c in categories)
                                        {
                                            <option value="@c.Id">@c.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 mt-4">2. Giá Bán & Kho Hàng</h6>
                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-dark">Đơn giá bán (VNĐ) <span class="text-danger">*</span></label>
                                    <input type="number" @bind="inputProduct.Price" step="1000" min="0" class="form-control form-control-admin" placeholder="29900000" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-dark">Số lượng tồn kho <span class="text-danger">*</span></label>
                                    <input type="number" @bind="inputProduct.Quantity" min="0" class="form-control form-control-admin" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-dark">Bảo hành (tháng) <span class="text-danger">*</span></label>
                                    <input type="number" @bind="inputProduct.WarrantyMonths" min="0" class="form-control form-control-admin" required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-semibold text-dark">Trạng thái kinh doanh</label>
                                    <select @bind="inputProduct.IsActive" class="form-select form-select-admin">
                                        <option value="true">Đang bán (Hiển thị cho khách mua)</option>
                                        <option value="false">Tạm ẩn (Ẩn khỏi trang bán hàng)</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Cột Phải: Hình ảnh & Cấu hình -->
                        <div class="col-lg-5">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">3. Hình Ảnh Sản Phẩm</h6>

                            <div class="d-flex gap-3 mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="blazorImgSource" id="blzImgSrcUrl" checked="@(imageSource == "url")" @onchange='() => imageSource = "url"'>
                                    <label class="form-check-label small fw-semibold" for="blzImgSrcUrl">Đường dẫn URL ảnh</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="blazorImgSource" id="blzImgSrcFile" checked="@(imageSource == "upload")" @onchange='() => imageSource = "upload"'>
                                    <label class="form-check-label small fw-semibold" for="blzImgSrcFile">Tải tệp từ máy tính</label>
                                </div>
                            </div>

                            @if (imageSource == "url")
                            {
                                <div class="mb-3">
                                    <input type="url" @bind="inputProduct.ImageUrl" @bind:event="oninput" class="form-control form-control-admin" placeholder="Dán link ảnh https://..." />
                                </div>
                            }
                            else
                            {
                                <div class="mb-3">
                                    <InputFile OnChange="HandleFileSelected" accept="image/*" class="form-control form-control-admin" />
                                </div>
                            }

                            <!-- Khung xem trước ảnh trực quan -->
                            <div class="border rounded-3 p-3 text-center bg-light mb-3" style="min-height: 140px; display: flex; align-items: center; justify-content: center; flex-direction: column;">
                                @if (!string.IsNullOrWhiteSpace(inputProduct.ImageUrl))
                                {
                                    <img src="@inputProduct.ImageUrl" alt="Xem trước" class="rounded-3 shadow-sm mb-2" style="max-height: 120px; max-width: 100%; object-fit: contain;" />
                                    <span class="small text-secondary">Ảnh sản phẩm đang chọn</span>
                                }
                                else
                                {
                                    <span class="small text-secondary">Chưa chọn ảnh hoặc chưa nhập liên kết ảnh.</span>
                                }
                            </div>

                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 mt-4">4. Cấu Hình & Mô Tả</h6>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-dark">Thông số kỹ thuật tóm tắt</label>
                                <textarea @bind="inputProduct.Specifications" rows="3" class="form-control form-control-admin" placeholder="Apple A18 Pro, 8GB RAM, 6.9 inch OLED 120Hz..."></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-dark">Mô tả bài viết giới thiệu thiết bị</label>
                                <textarea @bind="inputProduct.Description" rows="4" class="form-control form-control-admin" placeholder="Nhập bài viết giới thiệu chi tiết công nghệ, tính năng nổi bật..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top py-3 px-4 bg-light d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-4" @onclick="CloseModal">Hủy bỏ</button>
                    <button type="button" class="btn btn-primary rounded-3 px-4 fw-semibold shadow-sm" @onclick="SaveProduct">
                        Lưu Sản Phẩm
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Product> products = new();
    private List<Category> categories = new();
    private int totalCount = 0;
    private int totalPages = 1;
    private int currentPage = 1;
    private const int pageSize = 10;

    private string? searchKeyword;
    private int selectedCategoryId = 0;

    private bool showModal = false;
    private Product inputProduct = new();
    private string imageSource = "url";
    private string? alertMessage;
    private string? alertType;

    protected override void OnInitialized()
    {
        LoadCategories();
        LoadProducts();
    }

    private void LoadCategories()
    {
        categories = ProductService.GetCategories();
    }

    private void LoadProducts()
    {
        var all = ProductService.GetAllProducts();

        if (selectedCategoryId > 0)
        {
            all = all.Where(p => p.CategoryId == selectedCategoryId).ToList();
        }

        if (!string.IsNullOrWhiteSpace(searchKeyword))
        {
            all = all.Where(p => p.Name.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase) ||
                                 p.Brand.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        totalCount = all.Count;
        totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
        if (totalPages < 1) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;

        products = all.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }

    private void ApplyFilter()
    {
        currentPage = 1;
        LoadProducts();
    }

    private void ResetFilter()
    {
        searchKeyword = string.Empty;
        selectedCategoryId = 0;
        currentPage = 1;
        LoadProducts();
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ApplyFilter();
        }
    }

    private void ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        LoadProducts();
    }

    private void OpenAddModal()
    {
        inputProduct = new Product
        {
            Id = 0,
            Name = "",
            Brand = "",
            CategoryId = categories.FirstOrDefault()?.Id ?? 1,
            Price = 0,
            Quantity = 10,
            WarrantyMonths = 12,
            ImageUrl = "",
            Specifications = "",
            Description = "",
            IsActive = true
        };
        imageSource = "url";
        showModal = true;
    }

    private void OpenEditModal(Product p)
    {
        inputProduct = new Product
        {
            Id = p.Id,
            Name = p.Name,
            Brand = p.Brand,
            CategoryId = p.CategoryId,
            Price = p.Price,
            Quantity = p.Quantity,
            WarrantyMonths = p.WarrantyMonths,
            ImageUrl = p.ImageUrl,
            Specifications = p.Specifications,
            Description = p.Description,
            IsActive = p.IsActive
        };
        imageSource = "url";
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            try
            {
                var folderPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "images", "products");
                if (!Directory.Exists(folderPath))
                {
                    Directory.CreateDirectory(folderPath);
                }

                var fileName = $"{Guid.NewGuid()}_{file.Name}";
                var filePath = Path.Combine(folderPath, fileName);

                using (var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024))
                using (var fs = new FileStream(filePath, FileMode.Create))
                {
                    await stream.CopyToAsync(fs);
                }

                inputProduct.ImageUrl = $"/images/products/{fileName}";
            }
            catch (Exception ex)
            {
                alertMessage = "Lỗi khi tải ảnh: " + ex.Message;
                alertType = "danger";
            }
        }
    }

    private void SaveProduct()
    {
        if (string.IsNullOrWhiteSpace(inputProduct.Name))
        {
            alertMessage = "Vui lòng nhập tên thiết bị!";
            alertType = "danger";
            return;
        }

        try
        {
            if (inputProduct.Id == 0)
            {
                ProductService.AddProduct(inputProduct);
                alertMessage = "Thêm thiết bị mới thành công!";
            }
            else
            {
                ProductService.UpdateProduct(inputProduct);
                alertMessage = "Cập nhật thiết bị thành công!";
            }
            alertType = "success";
            showModal = false;
            LoadProducts();
        }
        catch (Exception ex)
        {
            alertMessage = "Lỗi khi lưu thiết bị: " + ex.Message;
            alertType = "danger";
        }
    }

    private void ToggleActive(Product p)
    {
        p.IsActive = !p.IsActive;
        ProductService.UpdateProduct(p);
        alertMessage = $"Đã {(p.IsActive ? "bật hiển thị" : "tạm ẩn")} thiết bị {p.Name}!";
        alertType = "info";
    }

    private async Task DeleteProduct(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa thiết bị này khỏi hệ thống?");
        if (!confirmed) return;

        ProductService.DeleteProduct(id);
        alertMessage = "Đã cập nhật danh sách thiết bị thành công!";
        alertType = "success";
        LoadProducts();
    }
}
