@page "/admin/orders"
@layout AdminLayout
@inject IProductService ProductService
@inject IJSRuntime JS

<PageTitle>Admin - Duyệt Đơn Hàng - ElectroStore</PageTitle>

<style>
    @@media print {
        .admin-sidebar, .admin-navbar, .btn-close, .modal-footer, .admin-stat-card, .admin-chip-btn, .table-responsive > table:not(.modal *), .admin-card:not(.modal *) {
            display: none !important;
        }
        .modal {
            position: static !important;
            display: block !important;
            background: none !important;
        }
        .modal-dialog {
            max-width: 100% !important;
            margin: 0 !important;
        }
        .modal-content {
            border: none !important;
            box-shadow: none !important;
        }
    }
</style>

<div class="container-fluid p-0">
    <!-- Tiêu Đề -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <span>Quản Lý & Duyệt Đơn Hàng</span>
                <span class="badge bg-primary rounded-pill fs-6 px-3">@filteredOrders.Count đơn hàng</span>
            </h3>
            <p class="text-secondary small mb-0">Theo dõi tiến độ từ Tiếp nhận đơn, Đã duyệt, Đang giao đến Hoàn thành.</p>
        </div>
    </div>

    <!-- Thông báo Alert -->
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert alert-@(alertType ?? "success") alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                </svg>
                <div>@alertMessage</div>
            </div>
            <button type="button" class="btn-close" @onclick="() => alertMessage = null" aria-label="Close"></button>
        </div>
    }

    <!-- ================= 1. KPI SUMMARY CARDS ================= -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Tổng đơn hiển thị</div>
                    <div class="stat-value">@orders.Count</div>
                    <div class="stat-subtext">Trong hệ thống</div>
                </div>
                <div class="stat-icon-wrap blue">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Chờ duyệt</div>
                    <div class="stat-value text-warning">@orders.Count(o => NormalizeStatus(o.OrderStatus) == "Pending")</div>
                    <div class="stat-subtext">Cần xử lý ngay</div>
                </div>
                <div class="stat-icon-wrap amber">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Đang giao</div>
                    <div class="stat-value text-info">@orders.Count(o => NormalizeStatus(o.OrderStatus) == "Shipping")</div>
                    <div class="stat-subtext">Đang phát cho khách</div>
                </div>
                <div class="stat-icon-wrap purple">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Doanh thu thực tế</div>
                    <div class="stat-value text-success" style="font-size: 1.35rem;">
                        @orders.Where(o => NormalizeStatus(o.OrderStatus) == "Completed").Sum(o => o.TotalAmount).ToString("N0") ₫
                    </div>
                    <div class="stat-subtext">Đơn hoàn thành (@orders.Count(o => NormalizeStatus(o.OrderStatus) == "Completed"))</div>
                </div>
                <div class="stat-icon-wrap green">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= 2. SEARCH & STATUS FILTER BAR ================= -->
    <div class="admin-card mb-3">
        <div class="admin-card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-9 col-lg-10">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                            </svg>
                        </span>
                        <input type="text" @bind="searchKeyword" @bind:event="oninput" @bind:after="ApplyFilter"
                               class="form-control form-control-admin border-start-0 ps-0" 
                               placeholder="Tìm theo mã đơn (ví dụ: #ES0000001 hoặc 1), tên khách hàng, số điện thoại, địa chỉ giao hàng..." />
                    </div>
                </div>
                <div class="col-md-3 col-lg-2 d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-3 w-100 py-2 fw-semibold"
                            @onclick='() => { searchKeyword = ""; ApplyFilter(); }' disabled="@string.IsNullOrWhiteSpace(searchKeyword)">
                        Xóa tìm kiếm
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Chips -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <button type="button" class="admin-chip-btn @(string.IsNullOrEmpty(statusFilter) ? "active" : "")" @onclick='() => SetStatusFilter("")'>
            Tất cả đơn
        </button>
        <button type="button" class="admin-chip-btn @(statusFilter == "Pending" ? "active" : "")" @onclick='() => SetStatusFilter("Pending")'>
            <span class="status-dot" style="background:#f59e0b;"></span>
            <span>Chờ duyệt</span>
        </button>
        <button type="button" class="admin-chip-btn @(statusFilter == "Confirmed" ? "active" : "")" @onclick='() => SetStatusFilter("Confirmed")'>
            <span class="status-dot" style="background:#3b82f6;"></span>
            <span>Đã duyệt</span>
        </button>
        <button type="button" class="admin-chip-btn @(statusFilter == "Shipping" ? "active" : "")" @onclick='() => SetStatusFilter("Shipping")'>
            <span class="status-dot" style="background:#6366f1;"></span>
            <span>Đang giao</span>
        </button>
        <button type="button" class="admin-chip-btn @(statusFilter == "Completed" ? "active" : "")" @onclick='() => SetStatusFilter("Completed")'>
            <span class="status-dot" style="background:#10b981;"></span>
            <span>Hoàn thành</span>
        </button>
        <button type="button" class="admin-chip-btn @(statusFilter == "Cancelled" ? "active" : "")" @onclick='() => SetStatusFilter("Cancelled")'>
            <span class="status-dot" style="background:#ef4444;"></span>
            <span>Đã hủy</span>
        </button>
    </div>

    <!-- ================= 3. ORDERS TABLE ================= -->
    <div class="admin-card mb-4">
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="ps-4">Mã Đơn</th>
                        <th>Khách Hàng</th>
                        <th>Liên Hệ & Địa Chỉ</th>
                        <th>Thời Gian Đặt</th>
                        <th>Tổng Thanh Toán</th>
                        <th>Trạng Thái</th>
                        <th class="pe-4 text-end">Xử Lý Đơn</th>
                    </tr>
                </thead>
                <tbody>
                    @if (filteredOrders.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-secondary">
                                <div class="py-3">
                                    <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-muted mb-2">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                    </svg>
                                    <div class="fw-semibold">Không có đơn hàng nào trong danh mục này!</div>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var o in filteredOrders)
                    {
                        var normStatus = NormalizeStatus(o.OrderStatus);
                        <tr>
                            <td class="ps-4">
                                <span class="fw-bold text-primary font-monospace">#ES@(o.Id.ToString("D7"))</span>
                            </td>
                            <td>
                                <div class="text-dark fw-bold">@(o.ReceiverName ?? o.User?.FullName ?? "Khách vãng lai")</div>
                                <div class="text-secondary small">@(o.User?.Email ?? o.User?.UserName ?? "Khách mua nhanh")</div>
                            </td>
                            <td>
                                <div class="text-dark small fw-semibold">@(o.ReceiverPhone ?? o.User?.PhoneNumber ?? "—")</div>
                                <div class="text-secondary small text-truncate" style="max-width: 240px;" title="@o.ShippingAddress">@o.ShippingAddress</div>
                            </td>
                            <td>
                                <span class="small text-secondary">@o.OrderDate.ToString("dd/MM/yyyy • HH:mm")</span>
                            </td>
                            <td>
                                <span class="fw-bold text-dark">@o.TotalAmount.ToString("N0") ₫</span>
                            </td>
                            <td>
                                @{
                                    var (bClass, bText) = normStatus switch
                                    {
                                        "Pending" => ("pending", "Chờ duyệt"),
                                        "Confirmed" => ("confirmed", "Đã duyệt"),
                                        "Shipping" => ("shipping", "Đang giao"),
                                        "Completed" => ("completed", "Hoàn thành"),
                                        "Cancelled" => ("cancelled", "Đã hủy"),
                                        _ => ("pending", o.OrderStatus)
                                    };
                                }
                                <span class="badge-pill-status @bClass">
                                    <span class="status-dot"></span>
                                    <span>@bText</span>
                                </span>
                            </td>
                            <td class="pe-4 text-end">
                                <div class="d-inline-flex gap-1 align-items-center">
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-2.5 py-1 small fw-semibold"
                                            @onclick="() => OpenDetailModal(o)">
                                        Chi tiết
                                    </button>

                                    @if (normStatus == "Pending")
                                    {
                                        <button type="button" class="btn btn-sm btn-primary rounded-3 px-2.5 py-1 small fw-semibold"
                                                @onclick='() => ChangeStatus(o.Id, "Confirmed")'>
                                            Duyệt đơn
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-3 px-2.5 py-1 small fw-semibold"
                                                @onclick="() => ConfirmCancelOrder(o.Id)">
                                            Hủy
                                        </button>
                                    }
                                    else if (normStatus == "Confirmed")
                                    {
                                        <button type="button" class="btn btn-sm btn-info text-white rounded-3 px-2.5 py-1 small fw-semibold"
                                                @onclick='() => ChangeStatus(o.Id, "Shipping")'>
                                            Giao hàng
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-3 px-2.5 py-1 small fw-semibold"
                                                @onclick="() => ConfirmCancelOrder(o.Id)">
                                            Hủy đơn
                                        </button>
                                    }
                                    else if (normStatus == "Shipping")
                                    {
                                        <button type="button" class="btn btn-sm btn-success rounded-3 px-2.5 py-1 small fw-semibold"
                                                @onclick='() => ChangeStatus(o.Id, "Completed")'>
                                            Hoàn tất
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-3 px-2.5 py-1 small fw-semibold"
                                                @onclick="() => ConfirmCancelOrder(o.Id)">
                                            Hủy / Bom
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= MODAL CHI TIẾT ĐƠN HÀNG ================= -->
@if (selectedOrder != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header border-bottom py-3 px-4 bg-light">
                    <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                        <span>Chi Tiết Đơn Hàng #ES@(selectedOrder.Id.ToString("D7"))</span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => selectedOrder = null" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="bg-light p-3 rounded-3 mb-4 border">
                        <div class="row g-2 small">
                            <div class="col-md-6"><strong>Người nhận:</strong> @(selectedOrder.ReceiverName ?? "—")</div>
                            <div class="col-md-6"><strong>Số điện thoại:</strong> @(selectedOrder.ReceiverPhone ?? "—")</div>
                            <div class="col-md-6"><strong>Thanh toán:</strong> @selectedOrder.PaymentMethod</div>
                            <div class="col-md-6"><strong>Ngày đặt:</strong> @selectedOrder.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                            <div class="col-12"><strong>Địa chỉ giao:</strong> @selectedOrder.ShippingAddress</div>
                            @if (!string.IsNullOrWhiteSpace(selectedOrder.Notes))
                            {
                                <div class="col-12 text-warning-emphasis bg-warning bg-opacity-10 p-2 rounded border border-warning-subtle">
                                    <strong>Ghi chú nhận hàng:</strong> @selectedOrder.Notes
                                </div>
                            }
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Danh Sách Thiết Bị Đặt Mua</h6>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead class="table-light small text-secondary">
                                <tr>
                                    <th>Thiết Bị</th>
                                    <th class="text-center">Số Lượng</th>
                                    <th class="text-end">Đơn Giá</th>
                                    <th class="text-end">Thành Tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in selectedOrder.OrderDetails)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <img src="@(string.IsNullOrEmpty(d.Product?.ImageUrl) ? "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9" : d.Product.ImageUrl)"
                                                     alt="@d.Product?.Name" style="width: 38px; height: 38px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0;" />
                                                <div>
                                                    <div class="text-dark fw-bold small">@(d.Product?.Name ?? "Thiết bị")</div>
                                                    <div class="text-secondary" style="font-size:0.75rem;">@d.Product?.Brand</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center fw-bold">@d.Quantity</td>
                                        <td class="text-end small">@d.UnitPrice.ToString("N0") ₫</td>
                                        <td class="text-end fw-bold text-dark">@((d.Quantity * d.UnitPrice).ToString("N0")) ₫</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="border-top">
                                    <td colspan="3" class="text-end fw-bold pt-3">Tổng giá trị đơn:</td>
                                    <td class="text-end fw-bold text-primary pt-3 fs-6">@selectedOrder.TotalAmount.ToString("N0") ₫</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="modal-footer border-top py-2.5 px-4 bg-light d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-primary rounded-3 px-3 d-flex align-items-center gap-2" @onclick="PrintInvoice">
                        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                        <span>In Phiếu Giao Hàng</span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-4" @onclick="() => selectedOrder = null">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Order> orders = new();
    private List<Order> filteredOrders = new();
    private string statusFilter = "";
    private string searchKeyword = "";
    private string? alertMessage;
    private string? alertType;
    private Order? selectedOrder;

    protected override void OnInitialized()
    {
        LoadOrders();
    }

    private void LoadOrders()
    {
        orders = ProductService.GetOrders();
        ApplyFilter();
    }

    private string NormalizeStatus(string? status)
    {
        if (string.IsNullOrEmpty(status)) return "Pending";
        return status switch
        {
            "Chờ xử lý" or "Pending" => "Pending",
            "Đã duyệt" or "Confirmed" => "Confirmed",
            "Đang giao hàng" or "Đang giao" or "Shipping" => "Shipping",
            "Hoàn thành" or "Completed" => "Completed",
            "Đã hủy" or "Cancelled" => "Cancelled",
            _ => status
        };
    }

    private void SetStatusFilter(string status)
    {
        statusFilter = status;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var query = orders.AsEnumerable();

        if (!string.IsNullOrEmpty(statusFilter))
        {
            query = query.Where(o => NormalizeStatus(o.OrderStatus) == statusFilter);
        }

        if (!string.IsNullOrWhiteSpace(searchKeyword))
        {
            var kw = searchKeyword.Trim().ToLower();
            var cleanKw = kw.Replace("#", "").Replace("es", "").TrimStart('0');
            int.TryParse(cleanKw, out int searchOrderId);

            query = query.Where(o => (searchOrderId > 0 && o.Id == searchOrderId) ||
                                     (o.ReceiverName != null && o.ReceiverName.ToLower().Contains(kw)) ||
                                     (o.ReceiverPhone != null && o.ReceiverPhone.Contains(kw)) ||
                                     (o.ShippingAddress != null && o.ShippingAddress.ToLower().Contains(kw)) ||
                                     (o.User != null && o.User.FullName != null && o.User.FullName.ToLower().Contains(kw)) ||
                                     (o.User != null && o.User.PhoneNumber != null && o.User.PhoneNumber.Contains(kw)));
        }

        filteredOrders = query.ToList();
    }

    private void OpenDetailModal(Order o)
    {
        selectedOrder = o;
    }

    private void ChangeStatus(int orderId, string newStatus)
    {
        ProductService.UpdateOrderStatus(orderId, newStatus);
        alertMessage = $"Đã cập nhật trạng thái đơn hàng #ES{orderId:D7} sang '{newStatus}'!";
        alertType = "success";
        LoadOrders();
    }

    private async Task ConfirmCancelOrder(int orderId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn hủy đơn hàng này? Số lượng tồn kho sẽ được tự động hoàn lại.");
        if (confirmed)
        {
            ChangeStatus(orderId, "Cancelled");
        }
    }

    private async Task PrintInvoice()
    {
        await JS.InvokeVoidAsync("window.print");
    }
}
