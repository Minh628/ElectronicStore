@page "/checkout"
@inject CartService Cart
@inject IProductService ProductService
@inject UserService UserService
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<ElectronicStore_blazor.Data.ElectronicStoreDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Hoàn Tất Đơn Hàng - ElectroStore</PageTitle>

<div class="container py-3">
    <!-- Breadcrumb -->
    <nav class="mb-3" style="--bs-breadcrumb-divider: '›';">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a href="" class="text-secondary text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="cart" class="text-secondary text-decoration-none">Giỏ hàng</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Thanh toán</li>
        </ol>
    </nav>

    <!-- Header & Stepper -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="fw-bold text-dark mb-1" style="font-size:2.2rem; letter-spacing:-0.02em;">Hoàn tất đơn hàng</h1>
            <p class="text-secondary small mb-0">Chỉ còn một bước để công nghệ mới đến với bạn.</p>
        </div>

        <!-- Stepper -->
        <div class="checkout-stepper m-0">
            <a href="cart" class="stepper-step completed">
                <span class="stepper-num">1</span>
                <span>Giỏ hàng</span>
            </a>
            <div class="stepper-divider"></div>
            <div class="stepper-step active">
                <span class="stepper-num">2</span>
                <span>Thanh toán</span>
            </div>
            <div class="stepper-divider"></div>
            <div class="stepper-step">
                <span class="stepper-num">3</span>
                <span>Hoàn tất</span>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger rounded-3 mb-4">
            @errorMessage
        </div>
    }

    @if (!UserService.IsAuthenticated && !allowGuestCheckout)
    {
        <!-- Bắt buộc đăng nhập kèm tùy chọn mua nhanh -->
        <div class="bg-white border rounded-4 text-center py-5 my-4 p-4 shadow-sm" style="max-width: 640px; margin: 0 auto;">
            <div class="mb-3 d-inline-flex p-3 rounded-circle bg-primary bg-opacity-10 text-primary">
                <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
            </div>
            <h4 class="text-dark fw-bold mb-2">Vui lòng đăng nhập để thanh toán</h4>
            <p class="text-secondary small mb-4" style="max-width: 440px; margin: 0 auto;">
                Tài khoản thành viên giúp bạn theo dõi lộ trình đơn hàng và kích hoạt bảo hành điện tử chính hãng.
            </p>
            <div class="d-flex flex-wrap gap-2 justify-content-center mb-3">
                <a href="account/login?returnUrl=checkout" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold" style="background:var(--accent-blue); border:none;">
                    Đăng nhập ngay
                </a>
                <a href="account/register?returnUrl=checkout" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                    Tạo tài khoản mới
                </a>
            </div>
            <div>
                <button type="button" class="btn btn-link text-decoration-none small text-secondary" @onclick="() => allowGuestCheckout = true">
                    Hoặc đặt hàng nhanh không cần tài khoản &darr;
                </button>
            </div>
        </div>
    }
    else if (!Cart.Items.Any())
    {
        <div class="bg-white border rounded-4 text-center py-5 my-4 p-4">
            <h4 class="text-dark fw-bold mb-2">Giỏ hàng của bạn đang trống!</h4>
            <p class="text-secondary small mb-3">Vui lòng chọn sản phẩm trước khi thanh toán.</p>
            <a href="" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold" style="background:var(--accent-blue); border:none;">
                Khám phá sản phẩm
            </a>
        </div>
    }
    else
    {
        @if (UserService.IsAuthenticated && UserService.CurrentUser != null)
        {
            <!-- Banner xác thực tài khoản -->
            <div class="p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center" style="background:#eff6ff; border:1px solid #dbeafe;">
                <div class="d-flex align-items-center gap-2 small text-primary fw-medium">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                    <span>Bạn đã đăng nhập với tài khoản <strong>@UserService.CurrentUser.UserName</strong>. Đăng nhập là bắt buộc để đặt hàng và theo dõi đơn.</span>
                </div>
                <span class="badge bg-primary bg-opacity-10 text-primary small fw-bold">Đã xác thực</span>
            </div>
        }
        else
        {
            <!-- Banner thông báo mua hàng vãng lai -->
            <div class="p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center" style="background:#fefce8; border:1px solid #fef08a;">
                <div class="d-flex align-items-center gap-2 small text-warning-emphasis fw-medium">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span>Bạn đang đặt hàng nhanh không cần tài khoản. Sau khi đặt, bạn có thể tra cứu đơn hàng bằng Số điện thoại nhận hàng.</span>
                </div>
                <span class="badge bg-warning bg-opacity-25 text-dark small fw-bold">Khách vãng lai</span>
            </div>
        }

        <div class="row g-4">
            <!-- Cột trái: Form thông tin & Phương thức thanh toán -->
            <div class="col-lg-7">
                <!-- 01. Thông tin nhận hàng -->
                <div class="bg-white border rounded-4 p-4 mb-4 shadow-sm">
                    <h5 class="fw-bold text-dark mb-4">01. Thông tin nhận hàng</h5>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Họ và tên người nhận *</label>
                            <input type="text" @bind="fullName" class="form-control form-control-custom" placeholder="Ví dụ: Nguyễn Văn An" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Số điện thoại *</label>
                            <input type="tel" @bind="phoneNumber" class="form-control form-control-custom" placeholder="Ví dụ: 0901 234 567" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Địa chỉ nhận hàng *</label>
                        <input type="text" @bind="shippingAddress" class="form-control form-control-custom" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố" required />
                        <div class="small text-secondary mt-1">Vui lòng ghi rõ số nhà, tên đường, phường/xã, quận/huyện và tỉnh/thành.</div>
                    </div>

                    <div>
                        <label class="form-label small fw-semibold text-secondary">Ghi chú giao hàng (không bắt buộc)</label>
                        <input type="text" @bind="notes" class="form-control form-control-custom" placeholder="Vui lòng gọi trước khi giao 30 phút..." />
                    </div>
                </div>

                <!-- 02. Phương thức thanh toán -->
                <div class="bg-white border rounded-4 p-4 mb-4 shadow-sm">
                    <h5 class="fw-bold text-dark mb-4">02. Phương thức thanh toán</h5>

                    <div class="d-flex flex-column gap-2">
                        <!-- COD -->
                        <div class="payment-method-card @(paymentMethod == "COD" ? "active" : "")" @onclick='() => paymentMethod = "COD"'>
                            <input type="radio" name="paymentMethod" value="COD" checked="@(paymentMethod == "COD")" class="form-check-input mt-0" />
                            <div class="flex-grow-1">
                                <div class="fw-bold text-dark small">Thanh toán khi nhận hàng (COD)</div>
                                <div class="text-secondary small">Thanh toán cho nhân viên giao hàng khi nhận sản phẩm.</div>
                            </div>
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-secondary">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                        </div>

                        <!-- Bank Transfer QR -->
                        <div class="payment-method-card @(paymentMethod == "BankTransfer" ? "active" : "")" @onclick='() => paymentMethod = "BankTransfer"'>
                            <input type="radio" name="paymentMethod" value="BankTransfer" checked="@(paymentMethod == "BankTransfer")" class="form-check-input mt-0" />
                            <div class="flex-grow-1">
                                <div class="fw-bold text-dark small">Chuyển khoản ngân hàng qua QR</div>
                                <div class="text-secondary small">Mã QR và nội dung chuyển khoản hiển thị sau khi đặt hàng.</div>
                            </div>
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-secondary">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
                            </svg>
                        </div>

                        <!-- VNPAY -->
                        <div class="payment-method-card @(paymentMethod == "VNPAY" ? "active" : "")" @onclick='() => paymentMethod = "VNPAY"'>
                            <input type="radio" name="paymentMethod" value="VNPAY" checked="@(paymentMethod == "VNPAY")" class="form-check-input mt-0" />
                            <div class="flex-grow-1">
                                <div class="fw-bold text-dark small">VNPAY</div>
                                <div class="text-secondary small">Thẻ ATM, thẻ quốc tế và ứng dụng ngân hàng.</div>
                            </div>
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-secondary">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                            </svg>
                        </div>

                        <!-- MOMO -->
                        <div class="payment-method-card @(paymentMethod == "MOMO" ? "active" : "")" @onclick='() => paymentMethod = "MOMO"'>
                            <input type="radio" name="paymentMethod" value="MOMO" checked="@(paymentMethod == "MOMO")" class="form-check-input mt-0" />
                            <div class="flex-grow-1">
                                <div class="fw-bold text-dark small">MOMO</div>
                                <div class="text-secondary small">Thanh toán nhanh qua ví điện tử MoMo.</div>
                            </div>
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-secondary">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- 03. Delivery Estimate Banner -->
                <div class="p-3 rounded-4 d-flex align-items-center gap-3 small" style="background:#f0fdf4; border:1px solid #bbf7d0; color:#166534;">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="flex-shrink-0">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
                    </svg>
                    <div>
                        <strong>Dự kiến nhận hàng: @DateTime.Now.AddDays(2).ToString("dd/MM") – @DateTime.Now.AddDays(4).ToString("dd/MM/yyyy")</strong><br/>
                        <span>Miễn phí giao hàng toàn quốc • Kiểm tra hàng khi nhận</span>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Tóm tắt đơn hàng -->
            <div class="col-lg-5">
                <div class="order-summary-card sticky-top" style="top: 90px;">
                    <h5 class="fw-bold text-dark mb-3">Tóm tắt đơn hàng</h5>

                    <!-- Product List Preview -->
                    <div class="d-flex flex-column gap-3 mb-4" style="max-height: 280px; overflow-y: auto;">
                        @foreach (var item in Cart.Items)
                        {
                            <div class="d-flex align-items-center gap-3 pb-2 border-bottom" @key="item.ProductId">
                                <div class="bg-light rounded-3 p-1 d-flex align-items-center justify-content-center" style="width:52px; height:52px;">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9" : item.ImageUrl)" 
                                         alt="@item.ProductName" style="max-width:100%; max-height:100%; object-fit:contain;" />
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold text-dark small text-truncate" style="max-width:180px;">@item.ProductName</div>
                                    <div class="text-secondary small">Số lượng: @item.Quantity</div>
                                    <div class="text-dark small fw-semibold">@item.UnitPrice.ToString("N0") đ</div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-secondary">Tạm tính (@Cart.GetCount() sản phẩm)</span>
                        <span class="fw-bold text-dark">@Cart.GetTotal().ToString("N0") đ</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 small">
                        <span class="text-secondary">Giao hàng toàn quốc</span>
                        <span class="fw-bold text-success">Miễn phí</span>
                    </div>

                    <hr class="my-3 text-secondary opacity-25" />

                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                        <span class="fw-bold text-dark">Tổng thanh toán</span>
                        <span class="fw-extrabold text-primary fs-3">@Cart.GetTotal().ToString("N0") đ</span>
                    </div>
                    <div class="text-secondary small mb-4">Đã bao gồm VAT</div>

                    <button type="button" class="btn btn-primary w-100 py-3 fw-bold rounded-3 d-flex align-items-center justify-content-center gap-2 mb-3"
                            style="background:var(--accent-blue); border:none;"
                            @onclick="HandleSubmitOrder">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                        <span>Đặt hàng • @Cart.GetTotal().ToString("N0") đ</span>
                    </button>

                    <div class="text-center text-secondary small mb-3">
                        Thanh toán an toàn • Thông tin được bảo mật
                    </div>

                    <div class="small text-secondary" style="font-size:0.75rem; line-height: 1.5;">
                        Bằng việc đặt hàng, bạn đồng ý với Điều khoản mua hàng và Chính sách bảo mật của ElectroStore.
                    </div>

                    <div class="mt-3 pt-3 border-top small text-secondary d-flex align-items-center gap-2">
                        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                        <span>Cần hỗ trợ? Gọi <strong class="text-dark">1800 6868</strong></span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string fullName = "";
    private string phoneNumber = "";
    private string email = "";
    private string shippingAddress = "";
    private string paymentMethod = "COD";
    private string notes = "";
    private string errorMessage = "";
    private bool allowGuestCheckout = false;

    protected override void OnInitialized()
    {
        if (UserService.IsAuthenticated && UserService.CurrentUser != null)
        {
            var user = UserService.CurrentUser;
            fullName = user.FullName ?? user.UserName ?? "Khách hàng";
            phoneNumber = user.PhoneNumber ?? "";
            email = user.Email ?? "";
            shippingAddress = user.Address ?? "";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !UserService.IsAuthenticated)
        {
            var restored = await UserService.RestoreSessionAsync(JS);
            if (restored && UserService.CurrentUser != null)
            {
                var user = UserService.CurrentUser;
                fullName = user.FullName ?? user.UserName ?? "Khách hàng";
                phoneNumber = user.PhoneNumber ?? "";
                email = user.Email ?? "";
                shippingAddress = user.Address ?? "";
                StateHasChanged();
            }
        }
    }

    private async Task HandleSubmitOrder()
    {
        if (string.IsNullOrWhiteSpace(fullName) || string.IsNullOrWhiteSpace(phoneNumber) || string.IsNullOrWhiteSpace(shippingAddress))
        {
            errorMessage = "Vui lòng nhập đầy đủ Họ tên, Số điện thoại và Địa chỉ giao hàng!";
            return;
        }

        string? userId = (UserService.IsAuthenticated && UserService.CurrentUser != null) ? UserService.CurrentUser.Id : null;
        var result = ProductService.PlaceOrder(fullName, phoneNumber, email, shippingAddress, paymentMethod, notes, Cart.Items, userId);
        if (result.Success)
        {
            Cart.LastGuestOrderId = result.OrderId;
            try
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "electro_last_order_id", result.OrderId.ToString());
            }
            catch { }
            Cart.Clear();
            Navigation.NavigateTo($"ordersuccess?orderId={result.OrderId}&phone={Uri.EscapeDataString(phoneNumber.Trim())}");
        }
        else
        {
            errorMessage = result.Message;
        }
    }
}
