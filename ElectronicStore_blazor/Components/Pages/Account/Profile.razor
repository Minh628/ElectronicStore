@page "/profile"
@page "/account/profile"
@using ElectronicStore_blazor.Models.Entities
@using ElectronicStore_blazor.Services
@using Microsoft.AspNetCore.Identity
@inject UserService UserService
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Thông tin tài khoản - ElectroStore</PageTitle>

<div class="account-page py-4" style="background: #f8fafc; min-height: 80vh;">
    <div class="container">
        <!-- Breadcrumb -->
        <nav class="mb-4">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-secondary">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="my-orders" class="text-decoration-none text-secondary">Tài khoản</a></li>
                <li class="breadcrumb-item active text-dark fw-bold">Thông tin tài khoản</li>
            </ol>
        </nav>

        @if (!UserService.IsAuthenticated)
        {
            <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
                <div class="rounded-circle bg-light d-inline-flex p-4 mb-3 text-secondary">
                    <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                </div>
                <h4 class="fw-bold mb-2">Vui lòng đăng nhập</h4>
                <p class="text-secondary mb-4">Bạn cần đăng nhập để xem và cập nhật thông tin tài khoản.</p>
                <a href="account/login" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold">Đăng nhập ngay</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                <!-- ================= CỘT TRÁI: SIDEBAR THÔNG TIN ================= -->
                <div class="col-lg-3">
                    <div class="bg-white border rounded-4 p-4 shadow-sm mb-4">
                        <!-- Profile Card -->
                        <div class="d-flex align-items-center gap-3 pb-3 border-bottom mb-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm"
                                 style="width: 52px; height: 52px; background: linear-gradient(135deg, #2563eb, #3b82f6); font-size: 1.15rem;">
                                @GetInitials(UserService.CurrentUser?.FullName ?? UserService.CurrentUser?.UserName)
                            </div>
                            <div class="overflow-hidden">
                                <h6 class="fw-bold mb-0 text-truncate text-dark">@(UserService.CurrentUser?.FullName ?? UserService.CurrentUser?.UserName)</h6>
                                <span class="small text-secondary">@(UserService.CurrentUser?.UserName ?? "member")</span>
                            </div>
                        </div>

                        <!-- Menu điều hướng -->
                        <div class="d-flex flex-column gap-1">
                            <a href="my-orders" class="p-2 px-3 rounded-3 text-decoration-none small text-secondary d-flex align-items-center gap-2">
                                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                                </svg>
                                <span>Đơn hàng của tôi</span>
                            </a>
                            <a href="profile" class="p-2 px-3 rounded-3 text-decoration-none fw-semibold small d-flex align-items-center gap-2"
                               style="background: #eff6ff; color: var(--accent-blue);">
                                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                                <span>Thông tin tài khoản</span>
                            </a>
                        </div>

                        <hr class="my-3 text-secondary opacity-25" />

                        <!-- Đăng xuất -->
                        <button type="button" @onclick="HandleLogout" class="btn p-2 px-3 w-100 text-start rounded-3 text-danger small fw-semibold d-flex align-items-center gap-2 border-0 bg-transparent">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                            </svg>
                            <span>Đăng xuất</span>
                        </button>
                    </div>
                </div>

                <!-- ================= CỘT PHẢI: FORM CHỈNH SỬA THÔNG TIN ================= -->
                <div class="col-lg-9">
                    <!-- Tiêu đề trang -->
                    <div class="mb-4">
                        <h4 class="fw-bold mb-1 text-dark">Thông tin tài khoản</h4>
                        <p class="text-secondary small mb-0">Quản lý và cập nhật thông tin cá nhân cùng sổ địa chỉ của bạn.</p>
                    </div>

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success border-0 rounded-3 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
                            <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <div>@successMessage</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger border-0 rounded-3 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
                            <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                            </svg>
                            <div>@errorMessage</div>
                        </div>
                    }

                    <!-- Thẻ Form Cập Nhật -->
                    <div class="bg-white border rounded-4 p-4 p-md-5 shadow-sm mb-4">
                        <EditForm Model="model" OnValidSubmit="HandleSaveProfile">
                            <!-- 1. Thông tin cá nhân -->
                            <h6 class="fw-bold text-dark border-bottom pb-3 mb-4 d-flex align-items-center gap-2">
                                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                <span>Hồ sơ cá nhân</span>
                            </h6>

                            <div class="row g-3 mb-4">
                                <!-- Tên đăng nhập (Chỉ xem) -->
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-secondary">Tên đăng nhập</label>
                                    <input type="text" class="form-control bg-light" value="@model.UserName" disabled />
                                    <div class="form-text small">Tên đăng nhập không thể thay đổi sau khi tạo.</div>
                                </div>

                                <!-- Họ và tên -->
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-dark">Họ và tên <span class="text-danger">*</span></label>
                                    <InputText @bind-Value="model.FullName" class="form-control rounded-3" placeholder="Nhập họ và tên đầy đủ" />
                                </div>

                                <!-- Email -->
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-dark">Địa chỉ Email <span class="text-danger">*</span></label>
                                    <InputText @bind-Value="model.Email" class="form-control rounded-3" placeholder="name@domain.com" />
                                </div>

                                <!-- Số điện thoại -->
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-dark">Số điện thoại</label>
                                    <InputText @bind-Value="model.PhoneNumber" class="form-control rounded-3" placeholder="VD: 0901234567" />
                                </div>

                                <!-- Địa chỉ giao hàng mặc định -->
                                <div class="col-12" id="address">
                                    <label class="form-label small fw-semibold text-dark">Địa chỉ nhận hàng mặc định</label>
                                    <InputTextArea @bind-Value="model.Address" rows="3" class="form-control rounded-3" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố..." />
                                </div>
                            </div>

                            <!-- 2. Đổi mật khẩu (Tuỳ chọn) -->
                            <h6 class="fw-bold text-dark border-bottom pb-3 mb-4 mt-5 d-flex align-items-center gap-2">
                                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                </svg>
                                <span>Đổi mật khẩu (Bỏ qua nếu không muốn thay đổi)</span>
                            </h6>

                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-dark">Mật khẩu hiện tại</label>
                                    <InputText type="password" @bind-Value="model.CurrentPassword" class="form-control rounded-3" placeholder="••••••••" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-dark">Mật khẩu mới</label>
                                    <InputText type="password" @bind-Value="model.NewPassword" class="form-control rounded-3" placeholder="Tối thiểu 6 ký tự" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-dark">Xác nhận mật khẩu mới</label>
                                    <InputText type="password" @bind-Value="model.ConfirmPassword" class="form-control rounded-3" placeholder="Nhập lại mật khẩu mới" />
                                </div>
                            </div>

                            <!-- Nút Lưu thay đổi -->
                            <div class="d-flex justify-content-end gap-3 pt-3 border-top">
                                <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm" disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Đang cập nhật...</span>
                                    }
                                    else
                                    {
                                        <span>Lưu thay đổi</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private ProfileViewModel model = new();
    private string? successMessage;
    private string? errorMessage;
    private bool isSubmitting = false;

    protected override void OnInitialized()
    {
        LoadUserData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !UserService.IsAuthenticated)
        {
            var restored = await UserService.RestoreSessionAsync(JS);
            if (restored && UserService.CurrentUser != null)
            {
                LoadUserData();
                StateHasChanged();
            }
        }
    }

    private void LoadUserData()
    {
        if (UserService.CurrentUser != null)
        {
            model.UserName = UserService.CurrentUser.UserName ?? "";
            model.FullName = UserService.CurrentUser.FullName ?? "";
            model.Email = UserService.CurrentUser.Email ?? "";
            model.PhoneNumber = UserService.CurrentUser.PhoneNumber ?? "";
            model.Address = UserService.CurrentUser.Address ?? "";
        }
    }

    private async Task HandleSaveProfile()
    {
        successMessage = null;
        errorMessage = null;

        if (UserService.CurrentUser == null)
        {
            errorMessage = "Phiên làm việc hết hạn. Vui lòng đăng nhập lại.";
            return;
        }

        if (string.IsNullOrWhiteSpace(model.FullName))
        {
            errorMessage = "Vui lòng nhập họ và tên.";
            return;
        }

        if (string.IsNullOrWhiteSpace(model.Email))
        {
            errorMessage = "Vui lòng nhập địa chỉ email.";
            return;
        }

        isSubmitting = true;

        try
        {
            var user = await UserManager.FindByIdAsync(UserService.CurrentUser.Id);
            if (user == null)
            {
                errorMessage = "Không tìm thấy thông tin tài khoản!";
                isSubmitting = false;
                return;
            }

            // Cập nhật các trường thông tin cơ bản
            user.FullName = model.FullName.Trim();
            user.Email = model.Email.Trim();
            user.PhoneNumber = string.IsNullOrWhiteSpace(model.PhoneNumber) ? null : model.PhoneNumber.Trim();
            user.Address = string.IsNullOrWhiteSpace(model.Address) ? null : model.Address.Trim();

            // Xử lý đổi mật khẩu nếu người dùng nhập
            if (!string.IsNullOrWhiteSpace(model.NewPassword))
            {
                if (string.IsNullOrWhiteSpace(model.CurrentPassword))
                {
                    errorMessage = "Vui lòng nhập mật khẩu hiện tại để đổi mật khẩu mới.";
                    isSubmitting = false;
                    return;
                }

                if (model.NewPassword != model.ConfirmPassword)
                {
                    errorMessage = "Mật khẩu xác nhận không trùng khớp với mật khẩu mới.";
                    isSubmitting = false;
                    return;
                }

                var changePassResult = await UserManager.ChangePasswordAsync(user, model.CurrentPassword, model.NewPassword);
                if (!changePassResult.Succeeded)
                {
                    errorMessage = string.Join("; ", changePassResult.Errors.Select(e => e.Description));
                    isSubmitting = false;
                    return;
                }
            }

            var updateResult = await UserManager.UpdateAsync(user);
            if (updateResult.Succeeded)
            {
                // Đồng bộ lại dữ liệu trong singleton UserService
                UserService.UpdateCurrentUser(user);
                successMessage = "Cập nhật thông tin tài khoản thành công!";
                model.CurrentPassword = string.Empty;
                model.NewPassword = string.Empty;
                model.ConfirmPassword = string.Empty;
            }
            else
            {
                errorMessage = string.Join("; ", updateResult.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi lưu thông tin: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleLogout()
    {
        await UserService.LogoutAsync(JS);
        Navigation.NavigateTo("/");
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    public class ProfileViewModel
    {
        public string UserName { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;

        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
