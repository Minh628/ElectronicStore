@model List<ElectronicStore_mvc.Models.Entities.Product>
@{
    ViewData["Title"] = "Admin - Quản Lý Sản Phẩm";
    var categories = ViewBag.Categories as List<ElectronicStore_mvc.Models.Entities.Category> ?? new();
    int? selectedCategory = ViewBag.SelectedCategoryId;
    string? searchKeyword = ViewBag.Search;
    int totalCount = ViewBag.TotalCount ?? Model.Count;
    int totalPages = ViewBag.TotalPages ?? 1;
    int currentPage = ViewBag.CurrentPage ?? 1;

    var inStockCount = ViewBag.InStockCount ?? Model.Count(p => p.Quantity > 0);
    var lowOrOutCount = ViewBag.LowOrOutCount ?? Model.Count(p => p.Quantity <= 5);
    var totalSystemCount = ViewBag.TotalSystemProducts ?? totalCount;
}

<div class="container-fluid p-0">
    <!-- Tiêu Đề & Hành Động Chính -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <span>Quản Lý Sản Phẩm</span>
                <span class="badge bg-primary rounded-pill fs-6 px-3">@totalCount thiết bị</span>
            </h3>
            <p class="text-secondary small mb-0">Quản lý kho hàng, cập nhật giá bán, cấu hình chi tiết và trạng thái kinh doanh.</p>
        </div>
        <div>
            <button type="button" class="btn btn-primary rounded-3 px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm"
                    onclick="openAddModal()">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span>Thêm Thiết Bị Mới</span>
            </button>
        </div>
    </div>

    <!-- Alert Notification -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-circle-fill"></i>
                <div>@TempData["WarningMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ================= 1. KPI SUMMARY CARDS ================= -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Tổng thiết bị</div>
                    <div class="stat-value">@totalSystemCount</div>
                    <div class="stat-subtext">Trong hệ thống</div>
                </div>
                <div class="stat-icon-wrap blue">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Còn hàng</div>
                    <div class="stat-value text-success">@inStockCount</div>
                    <div class="stat-subtext">Đang sẵn sàng giao</div>
                </div>
                <div class="stat-icon-wrap green">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Hết / Cảnh báo kho</div>
                    <div class="stat-value text-danger">@lowOrOutCount</div>
                    <div class="stat-subtext">Cần nhập thêm hàng</div>
                </div>
                <div class="stat-icon-wrap amber">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-stat-card">
                <div>
                    <div class="stat-label">Ngành hàng</div>
                    <div class="stat-value text-primary">@categories.Count</div>
                    <div class="stat-subtext">Danh mục thiết bị</div>
                </div>
                <div class="stat-icon-wrap purple">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= 2. SEARCH & FILTER CONTROLS ================= -->
    <div class="admin-card mb-4">
        <div class="p-3">
            <form method="get" asp-action="Products" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-secondary">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        </span>
                        <input type="text" name="search" value="@searchKeyword"
                               class="form-control form-control-admin border-start-0 ps-0" placeholder="Tìm theo tên máy, hãng..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="categoryId" class="form-select form-select-admin">
                        <option value="">-- Tất cả danh mục --</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id" selected="@(selectedCategory == c.Id)">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-3 rounded-3 fw-semibold flex-grow-1">
                        Lọc Dữ Liệu
                    </button>
                    <a asp-action="Products" class="btn btn-outline-secondary px-3 rounded-3">
                        Đặt lại
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- ================= 3. PRODUCTS DATA TABLE ================= -->
    <div class="admin-card mb-4">
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="ps-4">Sản Phẩm</th>
                        <th>Hãng</th>
                        <th>Danh Mục</th>
                        <th>Đơn Giá</th>
                        <th>Tồn Kho</th>
                        <th>Bảo Hành</th>
                        <th>Trạng Thái</th>
                        <th class="pe-4 text-end">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-secondary">
                                <div class="py-3">
                                    <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-muted mb-2">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                                    </svg>
                                    <div class="fw-semibold">Không tìm thấy sản phẩm nào!</div>
                                    <div class="small">Hãy thử thay đổi từ khóa hoặc điều kiện lọc.</div>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9" : p.ImageUrl)"
                                         alt="@p.Name" class="admin-prod-thumb" />
                                    <div>
                                        <div class="text-dark fw-bold">@p.Name</div>
                                        <div class="text-secondary small text-truncate" style="max-width: 280px;">@p.Specifications</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border fw-semibold">@p.Brand</span>
                            </td>
                            <td>
                                <span class="text-secondary small fw-medium">@p.Category?.Name</span>
                                @if (p.Category != null && !p.Category.IsActive)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1 small" title="Danh mục này đang tạm ẩn">DM ẩn</span>
                                }
                            </td>
                            <td>
                                <span class="fw-bold text-dark">@p.Price.ToString("N0") ₫</span>
                            </td>
                            <td>
                                @if (p.Quantity > 10)
                                {
                                    <span class="badge-pill-stock instock">Còn @p.Quantity máy</span>
                                }
                                else if (p.Quantity > 0)
                                {
                                    <span class="badge-pill-stock lowstock">Sắp hết (@p.Quantity)</span>
                                }
                                else
                                {
                                    <span class="badge-pill-stock outstock">Hết hàng</span>
                                }
                            </td>
                            <td>
                                <span class="small text-secondary">@p.WarrantyMonths tháng</span>
                            </td>
                            <td>
                                <form method="post" asp-action="ToggleProductStatus" class="d-inline">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <input type="hidden" name="categoryId" value="@selectedCategory" />
                                    <input type="hidden" name="search" value="@searchKeyword" />
                                    <input type="hidden" name="currentPage" value="@currentPage" />
                                    <button type="submit" class="border-0 bg-transparent p-0" title="Bấm để bật/tắt hiển thị">
                                        @if (!p.IsActive)
                                        {
                                            <span class="badge-pill-status cancelled">
                                                <span class="status-dot"></span>
                                                <span>Tạm ẩn</span>
                                            </span>
                                        }
                                        else if (p.Category != null && !p.Category.IsActive)
                                        {
                                            <span class="badge-pill-status pending" title="Sản phẩm đang bật nhưng bị ẩn trên trang khách do Danh mục đang tạm ẩn">
                                                <span class="status-dot"></span>
                                                <span>Ẩn theo DM</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-pill-status completed">
                                                <span class="status-dot"></span>
                                                <span>Đang bán</span>
                                            </span>
                                        }
                                    </button>
                                </form>
                            </td>
                            <td class="pe-4 text-end">
                                <div class="d-inline-flex gap-1">
                                    @{
                                        var pJson = System.Text.Json.JsonSerializer.Serialize(new {
                                            id = p.Id,
                                            name = p.Name,
                                            brand = p.Brand,
                                            categoryId = p.CategoryId,
                                            price = p.Price,
                                            quantity = p.Quantity,
                                            warrantyMonths = p.WarrantyMonths,
                                            imageUrl = p.ImageUrl ?? "",
                                            specifications = p.Specifications ?? "",
                                            description = p.Description ?? "",
                                            isActive = p.IsActive
                                        });
                                    }
                                    <script type="application/json" id="prod-data-@p.Id">@Html.Raw(pJson)</script>
                                    <button type="button" class="admin-action-btn edit" title="Chỉnh sửa thiết bị"
                                            onclick="openEditModal(@p.Id)">
                                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                    </button>
                                    <form method="post" asp-action="DeleteProduct" asp-route-id="@p.Id" class="d-inline">
                                        <input type="hidden" name="filterCategoryId" value="@selectedCategory" />
                                        <input type="hidden" name="categoryId" value="@selectedCategory" />
                                        <input type="hidden" name="search" value="@searchKeyword" />
                                        <input type="hidden" name="currentPage" value="@currentPage" />
                                        <button type="submit" class="admin-action-btn delete" title="Xóa thiết bị"
                                                onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này khỏi hệ thống?');">
                                            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ================= 4. PHÂN TRANG ================= -->
    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-center gap-1 mb-4">
            <a asp-action="Products" asp-route-currentPage="@(currentPage - 1)" asp-route-categoryId="@selectedCategory" asp-route-search="@searchKeyword"
               class="btn btn-sm btn-white border rounded-3 px-3 @(currentPage <= 1 ? "disabled" : "")">&laquo; Trước</a>

            @for (int i = 1; i <= totalPages; i++)
            {
                <a asp-action="Products" asp-route-currentPage="@i" asp-route-categoryId="@selectedCategory" asp-route-search="@searchKeyword"
                   class="btn btn-sm rounded-3 px-3 fw-semibold @(currentPage == i ? "btn-primary" : "btn-white border")">@i</a>
            }

            <a asp-action="Products" asp-route-currentPage="@(currentPage + 1)" asp-route-categoryId="@selectedCategory" asp-route-search="@searchKeyword"
               class="btn btn-sm btn-white border rounded-3 px-3 @(currentPage >= totalPages ? "disabled" : "")">Sau &raquo;</a>
        </div>
    }
</div>

<!-- ================= MODAL THÊM / SỬA SẢN PHẨM ================= -->
<div class="modal fade" id="productModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header border-bottom py-3 px-4 bg-light">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="modalTitle">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    <span>Thêm Sản Phẩm Mới</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-action="SaveProduct" enctype="multipart/form-data">
                <div class="modal-body p-4">
                    <input type="hidden" id="prodId" name="Id" value="0" />
                    <input type="hidden" name="filterCategoryId" value="@selectedCategory" />
                    <input type="hidden" name="search" value="@searchKeyword" />
                    <input type="hidden" name="currentPage" value="@currentPage" />

                    <div class="row g-4">
                        <!-- Cột Trái: Thông tin chính -->
                        <div class="col-lg-7">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">1. Thông Tin Cơ Bản</h6>
                            <div class="row g-3 mb-3">
                                <div class="col-12">
                                    <label class="form-label small fw-semibold text-dark">Tên thiết bị <span class="text-danger">*</span></label>
                                    <input type="text" id="prodName" name="Name" class="form-control form-control-admin" placeholder="Ví dụ: iPhone 16 Pro Max 256GB" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-dark">Hãng sản xuất <span class="text-danger">*</span></label>
                                    <input type="text" id="prodBrand" name="Brand" class="form-control form-control-admin" placeholder="Apple, Samsung, Sony..." required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-dark">Danh mục ngành hàng <span class="text-danger">*</span></label>
                                    <select id="prodCategory" name="CategoryId" class="form-select form-select-admin" required>
                                        @foreach (var c in categories)
                                        {
                                            <option value="@c.Id">@c.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 mt-4">2. Giá Bán & Kho Hàng</h6>
                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-dark">Đơn giá bán (VNĐ) <span class="text-danger">*</span></label>
                                    <input type="number" id="prodPrice" name="Price" step="1000" min="0" class="form-control form-control-admin" placeholder="29900000" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-dark">Số lượng tồn kho <span class="text-danger">*</span></label>
                                    <input type="number" id="prodQuantity" name="Quantity" min="0" class="form-control form-control-admin" value="10" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-dark">Bảo hành (tháng) <span class="text-danger">*</span></label>
                                    <input type="number" id="prodWarranty" name="WarrantyMonths" min="0" class="form-control form-control-admin" value="12" required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-semibold text-dark">Trạng thái kinh doanh</label>
                                    <select id="prodIsActive" name="IsActive" class="form-select form-select-admin">
                                        <option value="true">Đang bán (Hiển thị cho khách mua)</option>
                                        <option value="false">Tạm ẩn (Ẩn khỏi trang bán hàng)</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Cột Phải: Hình ảnh & Cấu hình -->
                        <div class="col-lg-5">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">3. Hình Ảnh Sản Phẩm</h6>

                            <div class="d-flex gap-3 mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="imageSource" id="imgSrcUrl" value="url" checked onchange="toggleImageSource('url')">
                                    <label class="form-check-label small fw-semibold" for="imgSrcUrl">Đường dẫn URL ảnh</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="imageSource" id="imgSrcFile" value="file" onchange="toggleImageSource('file')">
                                    <label class="form-check-label small fw-semibold" for="imgSrcFile">Tải tệp từ máy tính</label>
                                </div>
                            </div>

                            <div id="urlInputContainer" class="mb-3">
                                <input type="text" id="prodImage" name="ImageUrl" class="form-control form-control-admin" placeholder="https://..." oninput="previewUrlImage(this.value)" />
                            </div>

                            <div id="fileInputContainer" class="mb-3" style="display:none;">
                                <input type="file" id="prodImageFile" name="imageFile" class="form-control form-control-admin" accept="image/*" onchange="previewLocalFile(this)" />
                            </div>

                            <div id="imagePreviewContainer" class="border rounded-3 p-3 text-center bg-light mb-3" style="min-height: 140px; display: flex; align-items: center; justify-content: center; flex-direction: column;">
                                <img id="imagePreviewImg" src="" alt="Xem trước" class="rounded-3 shadow-sm mb-2" style="max-height: 120px; max-width: 100%; object-fit: contain; display: none;" />
                                <span id="imagePreviewText" class="small text-secondary">Chưa chọn ảnh hoặc chưa nhập liên kết ảnh.</span>
                            </div>

                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 mt-4">4. Cấu Hình & Mô Tả</h6>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-dark">Thông số kỹ thuật tóm tắt</label>
                                <textarea id="prodSpecs" name="Specifications" rows="3" class="form-control form-control-admin" placeholder="Apple A18 Pro, 8GB RAM, 6.9 inch OLED 120Hz..."></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-dark">Mô tả bài viết giới thiệu thiết bị</label>
                                <textarea id="prodDesc" name="Description" rows="4" class="form-control form-control-admin" placeholder="Nhập bài viết giới thiệu chi tiết công nghệ, tính năng nổi bật của thiết bị..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top py-3 px-4 bg-light d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold shadow-sm">
                        Lưu Sản Phẩm
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var modalInstance;
    document.addEventListener("DOMContentLoaded", function () {
        var el = document.getElementById('productModal');
        if (el) modalInstance = new bootstrap.Modal(el);
    });

    function toggleImageSource(type) {
        if (type === 'url') {
            document.getElementById('urlInputContainer').style.display = 'block';
            document.getElementById('fileInputContainer').style.display = 'none';
        } else {
            document.getElementById('urlInputContainer').style.display = 'none';
            document.getElementById('fileInputContainer').style.display = 'block';
        }
    }

    function previewUrlImage(url) {
        var img = document.getElementById('imagePreviewImg');
        var text = document.getElementById('imagePreviewText');
        if (url && url.trim().length > 0) {
            img.src = url.trim();
            img.style.display = 'block';
            text.innerText = 'Xem trước ảnh liên kết';
        } else {
            img.style.display = 'none';
            text.innerText = 'Chưa chọn ảnh hoặc chưa nhập liên kết ảnh.';
        }
    }

    function previewLocalFile(input) {
        var img = document.getElementById('imagePreviewImg');
        var text = document.getElementById('imagePreviewText');
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                img.src = e.target.result;
                img.style.display = 'block';
                text.innerText = 'Tệp: ' + input.files[0].name;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function openAddModal() {
        document.getElementById('modalTitle').innerHTML = '<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg> <span>Thêm Thiết Bị Mới</span>';
        document.getElementById('prodId').value = 0;
        document.getElementById('prodName').value = '';
        document.getElementById('prodBrand').value = '';
        document.getElementById('prodPrice').value = '';
        document.getElementById('prodQuantity').value = '10';
        document.getElementById('prodWarranty').value = '12';
        document.getElementById('prodImage').value = '';
        if (document.getElementById('prodImageFile')) document.getElementById('prodImageFile').value = '';
        document.getElementById('prodSpecs').value = '';
        document.getElementById('prodDesc').value = '';
        document.getElementById('prodIsActive').value = 'true';
        document.getElementById('imgSrcUrl').checked = true;
        toggleImageSource('url');
        previewUrlImage('');
        if (modalInstance) modalInstance.show();
    }

    function openEditModal(prodId) {
        const scriptEl = document.getElementById('prod-data-' + prodId);
        if (!scriptEl) return;
        try {
            const data = JSON.parse(scriptEl.textContent);
            document.getElementById('modalTitle').innerHTML = '<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg> <span>Cập Nhật: ' + data.name + '</span>';
            document.getElementById('prodId').value = data.id;
            document.getElementById('prodName').value = data.name;
            document.getElementById('prodBrand').value = data.brand;
            document.getElementById('prodCategory').value = data.categoryId;
            document.getElementById('prodPrice').value = data.price;
            document.getElementById('prodQuantity').value = data.quantity;
            document.getElementById('prodWarranty').value = data.warrantyMonths;
            document.getElementById('prodImage').value = data.imageUrl || '';
            if (document.getElementById('prodImageFile')) document.getElementById('prodImageFile').value = '';
            document.getElementById('prodSpecs').value = data.specifications || '';
            document.getElementById('prodDesc').value = data.description || '';
            document.getElementById('prodIsActive').value = data.isActive ? 'true' : 'false';
            document.getElementById('imgSrcUrl').checked = true;
            toggleImageSource('url');
            previewUrlImage(data.imageUrl || '');
            if (modalInstance) modalInstance.show();
        } catch (e) {
            console.error('Lỗi đọc dữ liệu sản phẩm:', e);
        }
    }
</script>
}
