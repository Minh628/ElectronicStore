@model List<ElectronicStore_mvc.Models.Entities.Order>
@inject Microsoft.AspNetCore.Identity.UserManager<ElectronicStore_mvc.Models.Entities.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Đơn Hàng Của Tôi";
    var currentUser = (User.Identity != null && User.Identity.IsAuthenticated) ? await UserManager.GetUserAsync(User) : null;
    var userFullName = !string.IsNullOrWhiteSpace(currentUser?.FullName) ? currentUser.FullName : (User.Identity?.Name ?? "Khách vãng lai");
    var userSubText = (User.Identity != null && User.Identity.IsAuthenticated) ? (!string.IsNullOrWhiteSpace(currentUser?.Email) ? currentUser.Email : "Thành viên chính thức") : (!string.IsNullOrEmpty(ViewBag.PhoneNumber as string) ? (string)ViewBag.PhoneNumber : "Chưa đăng nhập");
    string? phoneNumber = ViewBag.PhoneNumber;
    string activeStatus = ViewBag.Status as string ?? "All";
    var allOrders = ViewBag.AllOrders as List<ElectronicStore_mvc.Models.Entities.Order> ?? Model ?? new();
    string NormalizeStatus(string? s) => s switch
    {
        "Chờ xử lý" or "Pending" => "Pending",
        "Đã duyệt" or "Confirmed" => "Confirmed",
        "Đang giao" or "Đang giao hàng" or "Shipping" => "Shipping",
        "Hoàn thành" or "Đã giao" or "Hoàn tất" or "Completed" => "Completed",
        "Đã hủy" or "Cancelled" => "Cancelled",
        _ => s ?? string.Empty
    };
}

<div class="container py-3">
    <!-- Breadcrumb -->
    <nav class="mb-4" style="--bs-breadcrumb-divider: '›';">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item text-secondary">Tài khoản</li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Đơn hàng của tôi</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Cột trái: Hồ sơ cá nhân & Menu -->
        <div class="col-lg-3">
            <div class="bg-white border rounded-4 p-4 shadow-sm mb-4">
                <!-- Avatar & Tên người dùng -->
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-primary fw-bold fs-5"
                         style="width: 52px; height: 52px; background: #eff6ff; border: 2px solid #bfdbfe;">
                        @{
                            var displayName = (User.Identity?.IsAuthenticated == true ? userFullName : (!string.IsNullOrEmpty(phoneNumber) ? phoneNumber : "KH"));
                            var initial = displayName.Length >= 2 ? displayName.Substring(0, 2).ToUpper() : displayName.ToUpper();
                        }
                        @initial
                    </div>
                    <div class="overflow-hidden">
                        <h6 class="fw-bold text-dark mb-0 text-truncate">
                            @(User.Identity?.IsAuthenticated == true ? userFullName : "Khách vãng lai")
                        </h6>
                        <span class="small text-secondary">@userSubText</span>
                    </div>
                </div>

                <!-- Menu bên trái -->
                <div class="d-flex flex-column gap-1">
                    <a asp-controller="Orders" asp-action="MyOrders" class="p-2 px-3 rounded-3 text-decoration-none fw-semibold small d-flex align-items-center gap-2"
                       style="background: #eff6ff; color: var(--accent-blue);">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                        </svg>
                        <span>Đơn hàng của tôi</span>
                    </a>
                    <a asp-controller="Account" asp-action="Profile" class="p-2 px-3 rounded-3 text-decoration-none small text-secondary d-flex align-items-center gap-2">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        <span>Thông tin tài khoản</span>
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="p-2 px-3 rounded-3 text-decoration-none small text-secondary d-flex align-items-center gap-2">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                        </svg>
                        <span>Tiếp tục mua hàng</span>
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <hr class="my-2 text-secondary opacity-25" />
                        <a asp-controller="Account" asp-action="Logout" class="p-2 px-3 rounded-3 text-danger text-decoration-none small text-start d-flex align-items-center gap-2">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                            </svg>
                            <span>Đăng xuất</span>
                        </a>
                    }
                </div>
            </div>

            <!-- Khối tra cứu nhanh bằng SĐT -->
            <div class="bg-white border rounded-4 p-4 shadow-sm">
                <h6 class="fw-bold text-dark mb-1">Tra cứu nhanh bằng SĐT</h6>
                <p class="text-secondary small mb-3">Kiểm tra đơn hàng đặt không cần tài khoản.</p>
                <form method="get" asp-action="MyOrders" class="d-flex flex-column gap-2">
                    <input type="tel" name="phoneNumber" value="@phoneNumber" class="form-control form-control-custom form-control-sm" placeholder="Nhập số điện thoại..." required />
                    <button type="submit" class="btn btn-outline-primary btn-sm rounded-3 fw-semibold">
                        Tra cứu ngay &rarr;
                    </button>
                </form>
            </div>
        </div>

        <!-- Cột phải: Danh sách đơn hàng -->
        <div class="col-lg-9">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                <div>
                    <h2 class="fw-bold text-dark mb-1" style="font-size:2rem; letter-spacing:-0.02em;">Đơn hàng của tôi</h2>
                    <p class="text-secondary small mb-0">Theo dõi hành trình của những thiết bị bạn đã đặt mua.</p>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 small py-2 mb-3" role="alert">
                    <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close small" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 small py-2 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close small" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Tab lọc trạng thái -->
            <div class="d-flex flex-wrap gap-2 mb-3">
                <a asp-controller="Orders" asp-action="MyOrders" asp-route-phoneNumber="@phoneNumber" asp-route-status="All"
                   class="category-tab-btn text-decoration-none @(activeStatus == "All" ? "active" : "")">
                    Tất cả (@allOrders.Count)
                </a>
                <a asp-controller="Orders" asp-action="MyOrders" asp-route-phoneNumber="@phoneNumber" asp-route-status="Pending"
                   class="category-tab-btn text-decoration-none @(activeStatus == "Pending" ? "active" : "")">
                    Chờ duyệt (@allOrders.Count(o => NormalizeStatus(o.OrderStatus) == "Pending"))
                </a>
                <a asp-controller="Orders" asp-action="MyOrders" asp-route-phoneNumber="@phoneNumber" asp-route-status="Confirmed"
                   class="category-tab-btn text-decoration-none @(activeStatus == "Confirmed" ? "active" : "")">
                    Đã duyệt (@allOrders.Count(o => NormalizeStatus(o.OrderStatus) == "Confirmed"))
                </a>
                <a asp-controller="Orders" asp-action="MyOrders" asp-route-phoneNumber="@phoneNumber" asp-route-status="Shipping"
                   class="category-tab-btn text-decoration-none @(activeStatus == "Shipping" ? "active" : "")">
                    Đang giao (@allOrders.Count(o => NormalizeStatus(o.OrderStatus) == "Shipping"))
                </a>
                <a asp-controller="Orders" asp-action="MyOrders" asp-route-phoneNumber="@phoneNumber" asp-route-status="Completed"
                   class="category-tab-btn text-decoration-none @(activeStatus == "Completed" ? "active" : "")">
                    Hoàn thành (@allOrders.Count(o => NormalizeStatus(o.OrderStatus) == "Completed"))
                </a>
                <a asp-controller="Orders" asp-action="MyOrders" asp-route-phoneNumber="@phoneNumber" asp-route-status="Cancelled"
                   class="category-tab-btn text-decoration-none @(activeStatus == "Cancelled" ? "active" : "")">
                    Đã hủy (@allOrders.Count(o => NormalizeStatus(o.OrderStatus) == "Cancelled"))
                </a>
            </div>

            <!-- Danh sách đơn hàng -->
            @if (Model == null || !Model.Any())
            {
                <div class="bg-white border rounded-4 text-center py-5 my-3 p-4">
                    <h5 class="fw-bold text-dark mb-2">Chưa có đơn hàng nào trong mục này</h5>
                    <p class="text-secondary small mb-3">Bạn chưa có đơn hàng hoặc chưa nhập số điện thoại để tra cứu.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold" style="background:var(--accent-blue); border:none;">
                        Khám phá sản phẩm
                    </a>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var order in Model)
                    {
                        var normStatus = NormalizeStatus(order.OrderStatus);
                        var statusClass = normStatus switch
                        {
                            "Pending" => "status-pending",
                            "Confirmed" => "status-confirmed",
                            "Shipping" => "status-shipping",
                            "Completed" => "status-completed",
                            "Cancelled" => "status-cancelled",
                            _ => "status-pending"
                        };
                        var statusLabel = normStatus switch
                        {
                            "Pending" => "Chờ duyệt",
                            "Confirmed" => "Đã duyệt",
                            "Shipping" => "Đang giao",
                            "Completed" => "Hoàn thành",
                            "Cancelled" => "Đã hủy",
                            _ => order.OrderStatus
                        };

                        <div class="bg-white border rounded-4 p-4 shadow-sm">
                            <!-- Card Header -->
                            <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 border-bottom mb-3 gap-2">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="fw-bold text-dark">#ES@(order.Id.ToString("D7"))</span>
                                    <span class="text-secondary small">@order.OrderDate.ToString("dd/MM/yyyy • HH:mm")</span>
                                </div>
                                <span class="demo-badge-status @statusClass">@statusLabel</span>
                            </div>

                            <!-- Products in this order -->
                            <div class="d-flex flex-column gap-3 mb-3">
                                @foreach (var d in order.OrderDetails)
                                {
                                    <div class="d-flex align-items-center justify-content-between gap-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="bg-light rounded-3 p-1 d-flex align-items-center justify-content-center" style="width:52px; height:52px;">
                                                <img src="@(string.IsNullOrEmpty(d.Product?.ImageUrl) ? "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9" : d.Product.ImageUrl)" 
                                                     alt="@d.Product?.Name" style="max-width:100%; max-height:100%; object-fit:contain;" />
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark small">@d.Product?.Name</div>
                                                <div class="text-secondary small">
                                                    @(d.Product?.Brand) • Số lượng: @d.Quantity
                                                </div>
                                            </div>
                                        </div>
                                        <div class="fw-semibold text-dark small">
                                            @d.TotalPrice.ToString("N0") đ
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Card Footer -->
                            <div class="d-flex flex-wrap justify-content-between align-items-end pt-3 border-top gap-3">
                                <div class="small text-secondary" style="max-width: 480px;">
                                    <div><strong>@(order.ReceiverName ?? order.User?.FullName)</strong> • @(order.ReceiverPhone ?? order.User?.PhoneNumber)</div>
                                    <div class="text-truncate">@order.ShippingAddress</div>
                                    <div class="text-muted">Thanh toán: @order.PaymentMethod • Miễn phí giao hàng</div>
                                </div>

                                <div class="text-end">
                                    <div class="small text-secondary">Tổng cộng</div>
                                    <div class="fw-extrabold text-primary fs-5 mb-2">
                                        @order.TotalAmount.ToString("N0") đ
                                    </div>
                                    <div class="d-flex align-items-center justify-content-end gap-2">
                                        @if (normStatus == "Pending" || normStatus == "Confirmed")
                                        {
                                            <form method="post" asp-action="CancelOrder" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không? Số lượng sản phẩm sẽ được tự động hoàn lại vào kho.')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="orderId" value="@order.Id" />
                                                <input type="hidden" name="phoneNumber" value="@phoneNumber" />
                                                <input type="hidden" name="status" value="@activeStatus" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1 fw-semibold small">
                                                    Hủy đơn hàng
                                                </button>
                                            </form>
                                        }
                                        <a asp-controller="Checkout" asp-action="OrderSuccess" asp-route-id="@order.Id" asp-route-phone="@(ViewBag.PhoneNumber ?? order.ReceiverPhone)" class="btn btn-light btn-sm rounded-pill px-3 py-1 fw-semibold small border text-decoration-none">
                                            Xem chi tiết &rarr;
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
